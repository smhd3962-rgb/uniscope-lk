<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4f46e5" />
      <stop offset="50%" stop-color="#7c3aed" />
      <stop offset="100%" stop-color="#ec4899" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fde047" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#4f46e5" flood-opacity="0.3"/>
    </filter>
  </defs>
  <!-- Background Circle with Glassmorphism gradient -->
  <circle cx="50" cy="50" r="46" fill="url(#grad1)" filter="url(#shadow)" />
  <!-- Inner Ring Scope Orbit -->
  <circle cx="50" cy="50" r="38" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="2" stroke-dasharray="4 3"/>
  <!-- Central Stylized 'U' & Compass Scope Nodes -->
  <path d="M30 35 V52 C30 63 39 72 50 72 C61 72 70 63 70 52 V35" fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round"/>
  <!-- Graduation Cap / Scope Chevron Accent -->
  <polygon points="50,22 74,34 50,44 26,34" fill="url(#goldGrad)" filter="url(#shadow)"/>
  <circle cx="50" cy="52" r="6" fill="#ffffff" />
  <circle cx="50" cy="52" r="3" fill="#7c3aed" />
  <!-- Star Sparkle at Top Corner -->
  <path d="M72 20 Q72 26 78 26 Q72 26 72 32 Q72 26 66 26 Q72 26 72 20 Z" fill="#fde047"/>
</svg>
