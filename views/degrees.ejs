<%- include('partials/head', { title: "Explore Degrees - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding-top: 84px; color:var(--text-main);">
  <!-- Gallery / Degree Header (Apple Minimalist) -->
  <div class="dg-header">
    <div style="max-width: 860px; margin: 0 auto;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:var(--bg-card); border:1px solid var(--border-subtle); padding:4px 14px; border-radius:980px; font-size:12px; font-weight:700; color:var(--apple-blue); letter-spacing:0.04em; text-transform:uppercase; margin-bottom:14px; box-shadow:var(--shadow-sm);">
        UGC Official Academic Registry
      </div>
      <h1 style="font-size: clamp(30px, 4.5vw, 44px); font-weight: 700; margin-bottom: 12px;">
        Explore All Sri Lankan University Degrees
      </h1>
      <p>
        Browse 255+ verified degree programs across all 17 UGC state universities
      </p>

      <!-- Search bar (Apple Spotlight Style) -->
      <form method="GET" action="/degrees/all/" style="max-width: 600px; margin: 0 auto; display: flex; gap: 8px; background: var(--bg-card); padding: 6px; border-radius: 980px; border: 1px solid var(--border-card); box-shadow: var(--shadow-sm);">
        <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="Search by degree name, university, or stream..." class="uniscope-input" style="flex:1; border:none; padding:10px 18px; font-size:15px; background:transparent; border-radius:980px; outline:none;">
        <button type="submit" class="btn-calc-action">
          Search
        </button>
      </form>
    </div>
  </div>

  <!-- Stream Filter Chips (Apple Segmented Control Style) -->
  <div class="dg-filters" style="display:flex; justify-content:center; flex-wrap:wrap;">
    <a href="/degrees/all/?q=<%= searchQuery || '' %>" class="dg-chip <%= !selectedStream ? 'active' : '' %>">
      All Streams
    </a>
    
    <a href="/degrees/all/?stream=Bio Science&q=<%= searchQuery || '' %>" class="dg-chip <%= selectedStream === 'Bio Science' ? 'active' : '' %>">
      <span style="width:7px;height:7px;border-radius:50%;background:#34c759;display:inline-block;"></span>
      Bio Science
    </a>

    <a href="/degrees/all/?stream=Physical Science&q=<%= searchQuery || '' %>" class="dg-chip <%= selectedStream === 'Physical Science' ? 'active' : '' %>">
      <span style="width:7px;height:7px;border-radius:50%;background:#0071e3;display:inline-block;"></span>
      Physical Science
    </a>

    <a href="/degrees/all/?stream=Commerce&q=<%= searchQuery || '' %>" class="dg-chip <%= selectedStream === 'Commerce' ? 'active' : '' %>">
      <span style="width:7px;height:7px;border-radius:50%;background:#ff9500;display:inline-block;"></span>
      Commerce
    </a>

    <a href="/degrees/all/?stream=Arts&q=<%= searchQuery || '' %>" class="dg-chip <%= selectedStream === 'Arts' ? 'active' : '' %>">
      <span style="width:7px;height:7px;border-radius:50%;background:#af52de;display:inline-block;"></span>
      Arts
    </a>

    <a href="/degrees/all/?stream=Technology&q=<%= searchQuery || '' %>" class="dg-chip <%= selectedStream === 'Technology' ? 'active' : '' %>">
      <span style="width:7px;height:7px;border-radius:50%;background:#30b0c7;display:inline-block;"></span>
      Technology
    </a>

    <a href="/degrees/all/?stream=Common&q=<%= searchQuery || '' %>" class="dg-chip <%= selectedStream === 'Common' ? 'active' : '' %>">
      <span style="width:7px;height:7px;border-radius:50%;background:#86868b;display:inline-block;"></span>
      Common
    </a>
  </div>

  <!-- Degrees Grid Body -->
  <div class="dg-body container" style="padding: 30px 20px 60px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px; flex-wrap:wrap; gap:12px;">
      <span style="color:var(--text-secondary); font-size:14px; font-weight:600;">
        Page <strong><%= page %></strong> of <strong><%= totalPages %></strong> &nbsp;·&nbsp; <strong><%= totalCount %></strong> total degrees
      </span>
      <div style="font-size:13px; color:var(--apple-blue); font-weight:600; display:flex; align-items:center; gap:6px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        Click the bookmark icon on any card to add to Degree Cart &amp; Compare
      </div>
    </div>

    <div class="dg-grid" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
      <% degrees.forEach(function(d) { %>
        <% var degImg = getDegreeImage(d); %>
        <% var uniLogo = getUniLogo(d.university); %>
        <div class="deg-card uniscope-card" style="overflow:hidden; display:flex; flex-direction:column; position:relative;">
          
          <!-- Degree Category Photographic Banner -->
          <div class="deg-img-wrap" style="height:148px; background:var(--bg-card-subtle); position:relative; overflow:hidden;">
            <img src="<%= degImg %>"
                 alt="<%= d.name %>"
                 loading="lazy"
                 onerror="this.onerror=null; this.src='/assets/placeholders/degree_placeholder.webp';"
                 style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s cubic-bezier(0.16,1,0.3,1);">
            
            <span class="deg-type-badge" style="position:absolute; top:12px; left:12px; background:rgba(0,0,0,0.65); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); color:#fff; padding:4px 10px; border-radius:980px; font-size:11px; font-weight:700; text-transform:uppercase;">
              <%= d.type || 'General' %>
            </span>

            <button class="deg-bookmark-btn dg-cart-btn"
                    data-uni-code="<%= d.code %>"
                    aria-label="Add to cart"
                    style="position:absolute; top:10px; right:10px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </button>

            <!-- Floating University Logo Emblem -->
            <div style="position:absolute; bottom:8px; left:12px; width:34px; height:34px; border-radius:8px; background:#ffffff; box-shadow:0 2px 8px rgba(0,0,0,0.18); border:1px solid rgba(0,0,0,0.06); display:flex; align-items:center; justify-content:center; padding:3px; z-index:2;">
              <img src="<%= uniLogo %>"
                   alt="<%= d.university %> Logo"
                   loading="lazy"
                   onerror="this.onerror=null; this.src='/assets/placeholders/university_logo_placeholder.svg';"
                   style="max-width:100%; max-height:100%; object-fit:contain;">
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="deg-body" style="padding:18px; flex:1; display:flex; flex-direction:column;">
            <div class="deg-name" style="font-size:16px; font-weight:700; letter-spacing:-0.015em; color:var(--text-main); margin-bottom:4px; line-height:1.35;">
              <%= d.name %>
            </div>

            <div class="deg-meta" style="font-size:12.5px; color:var(--text-secondary); margin-bottom:12px; display:flex; align-items:center; gap:6px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              <span><%= d.university %></span>
            </div>

            <div class="deg-streams" style="margin-bottom:14px; display:flex; align-items:center; gap:8px;">
              <span class="deg-stream-badge" style="background:var(--bg-card-subtle); color:var(--text-secondary); border:1px solid var(--border-subtle); padding:4px 10px; border-radius:980px; font-size:11px; font-weight:600;">
                <%= d.stream %>
              </span>
              <span style="font-size:11.5px; color:var(--text-secondary); font-weight:600;">
                Code: <%= d.code %>
              </span>
            </div>

            <div style="margin-top:auto; padding-top:14px; border-top:1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center;">
              <div class="deg-risk-row" style="display:flex; align-items:center; gap:8px;">
                <span class="deg-risk-text" style="font-size:12px; font-weight:700; color:var(--text-secondary);">
                  AI Risk: <%= d.risk %>%
                </span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:<%= d.risk <= 25 ? '#10b981' : (d.risk <= 50 ? '#f59e0b' : (d.risk <= 75 ? '#f97316' : '#ef4444')) %>;"></span>
              </div>

              <a href="/degrees/detail/<%= encodeURIComponent(d.code) %>/" class="deg-btn" style="text-decoration:none; background:var(--bg-card-subtle); color:#7c3aed; border:1px solid var(--border-subtle); padding:6px 14px; border-radius:8px; font-size:12.5px; font-weight:700;">
                View Degree →
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination Controls (Apple Minimalist Pills) -->
    <% if (totalPages > 1) { %>
      <div class="pagination-apple" style="display:flex; justify-content:center; gap:8px; margin-top:48px; flex-wrap:wrap; align-items:center;">
        <% if (page > 1) { %>
          <a href="/degrees/all/?page=<%= page - 1 %>&stream=<%= selectedStream %>&q=<%= searchQuery %>" style="padding:8px 20px; background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:980px; text-decoration:none; color:var(--text-main); font-weight:600; font-size:13.5px; box-shadow:var(--shadow-sm);">
            ← Previous
          </a>
        <% } %>

        <% for (var p = 1; p <= totalPages; p++) { %>
          <% if (p === page) { %>
            <span style="padding:8px 18px; background:var(--apple-blue); color:#fff; border-radius:980px; font-weight:700; font-size:13.5px; box-shadow:0 2px 8px rgba(0,113,227,0.3);">
              <%= p %>
            </span>
          <% } else if (p <= 3 || p >= totalPages - 1 || Math.abs(p - page) <= 1) { %>
            <a href="/degrees/all/?page=<%= p %>&stream=<%= selectedStream %>&q=<%= searchQuery %>" style="padding:8px 18px; background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:980px; text-decoration:none; color:var(--text-main); font-weight:600; font-size:13.5px;">
              <%= p %>
            </a>
          <% } else if (p === 4 && page > 4) { %>
            <span style="padding:8px 10px; color:var(--text-muted); font-size:13.5px;">…</span>
          <% } %>
        <% } %>

        <% if (page < totalPages) { %>
          <a href="/degrees/all/?page=<%= page + 1 %>&stream=<%= selectedStream %>&q=<%= searchQuery %>" style="padding:8px 20px; background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:980px; text-decoration:none; color:var(--text-main); font-weight:600; font-size:13.5px; box-shadow:var(--shadow-sm);">
            Next →
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
