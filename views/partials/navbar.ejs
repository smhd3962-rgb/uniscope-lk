  <script>
  // Bulletin notification read management
  (function() {
    try {
      if (localStorage.getItem('uniscope_bulletins_read') === 'true') {
        var b = document.getElementById('notifBadge');
        if (b) b.style.display = 'none';
      }
    } catch(e) {}
  })();

  function markAllRead() {
    try {
      localStorage.setItem('uniscope_bulletins_read', 'true');
      var b = document.getElementById('notifBadge');
      if (b) b.style.display = 'none';
    } catch(e) {}
  }
  </script>
