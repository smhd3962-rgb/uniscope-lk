  <script src="/static/home/js/script.js"></script>
  <script>
  // Mobile accordion toggle
  function toggleMobAcc(btn) {
    var body = btn.nextElementSibling;
    var isOpen = body.classList.contains('open');
    document.querySelectorAll('.mob-acc-body.open').forEach(function(b) { b.classList.remove('open'); });
    document.querySelectorAll('.mob-acc-btn.open').forEach(function(b) { b.classList.remove('open'); });
    if (!isOpen) { body.classList.add('open'); btn.classList.add('open'); }
  }

  // Theme toggle
  function toggleTheme() {
    var current = document.documentElement.getAttribute('data-theme') || 'light';
    var next = (current === 'dark') ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('uniscope_theme', next);
      localStorage.setItem('thush_theme', next);
    } catch(e) {}
  }

  // Notifications panel toggle
  function toggleNotifications() {
    var panel = document.getElementById('bpPanel');
    if (panel) {
      panel.classList.toggle('open');
    }
  }

  function markAllRead() {
    var badge = document.getElementById('notifBadge');
    if (badge) {
      badge.style.display = 'none';
    }
  }

  // Close notifications on outer click
  document.addEventListener('click', function(e) {
    var wrap = document.querySelector('.bp-wrap');
    var panel = document.getElementById('bpPanel');
    if (wrap && panel && !wrap.contains(e.target)) {
      panel.classList.remove('open');
    }
  });

  // Back to top button logic
  (function(){
    var btt = document.getElementById('backToTop');
    if (btt) {
      window.addEventListener('scroll', function(){ btt.classList.toggle('show', window.scrollY > 300); }, {passive:true});
      btt.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });
    }
  })();

  // Degree Cart client management
  (function(){
    var toast = document.getElementById('cartToast');
    var icon = document.getElementById('cartToastIcon');
    var msg = document.getElementById('cartToastMsg');
    var timer = null;
    var addedPath = '<circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-5"/>';
    var removedPath = '<circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>';

    window.showCartToast = function(status, name) {
      if (!toast) return;
      if (timer) clearTimeout(timer);
      if (status === 'added') {
        icon.innerHTML = addedPath;
        icon.style.stroke = '#4ade80';
        msg.textContent = (name ? name + ' added to' : 'Added to') + ' Degree Cart';
      } else {
        icon.innerHTML = removedPath;
        icon.style.stroke = '#f87171';
        msg.textContent = (name ? name + ' removed from' : 'Removed from') + ' Degree Cart';
      }
      toast.classList.remove('toast-hiding');
      toast.classList.add('toast-visible');
      timer = setTimeout(function(){
        toast.classList.remove('toast-visible');
        toast.classList.add('toast-hiding');
      }, 2500);
    };

    function updateNavCartCount() {
      try {
        var cart = JSON.parse(localStorage.getItem('uniscope_cart') || '[]');
        var countEl = document.getElementById('navCartCount');
        if (countEl) {
          countEl.textContent = cart.length;
          countEl.style.display = cart.length > 0 ? 'inline-flex' : 'none';
        }
        document.querySelectorAll('.dg-cart-btn').forEach(function(btn) {
          var code = btn.getAttribute('data-uni-code');
          if (cart.includes(code)) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      } catch(e) {}
    }

    window.toggleCart = function(code, name) {
      try {
        var cart = JSON.parse(localStorage.getItem('uniscope_cart') || '[]');
        var idx = cart.indexOf(code);
        var status = 'added';
        if (idx !== -1) {
          cart.splice(idx, 1);
          status = 'removed';
        } else {
          cart.push(code);
          status = 'added';
        }
        localStorage.setItem('uniscope_cart', JSON.stringify(cart));
        updateNavCartCount();
        window.showCartToast(status, name);

        // Sync with backend API
        fetch('/api/cart/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: code, status: status })
        }).catch(function(){});
      } catch(e) {}
    };

    document.addEventListener('DOMContentLoaded', updateNavCartCount);
    // Wire delegated clicks on degree cart buttons
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.dg-cart-btn');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        var code = btn.getAttribute('data-uni-code');
        var card = btn.closest('.deg-card');
        var name = card ? card.querySelector('.deg-name').textContent.trim() : '';
        window.toggleCart(code, name);
      }
    });
  })();

  // Counter animation on scroll for Stats Bar
  (function(){
    var done = false;
    var sio = new IntersectionObserver(function(e){
      e.forEach(function(en){
        if (en.isIntersecting && !done) {
          done = true;
          document.querySelectorAll('.hs-num').forEach(function(n, i){
            var t = +n.dataset.t, s = n.dataset.s || '', a = n.dataset.a || '';
            setTimeout(function(){
              var st = performance.now();
              (function tk(now){
                var p = Math.min((now - st) / 1800, 1), ease = 1 - Math.pow(1 - p, 4), v = Math.floor(ease * t);
                n.textContent = v + s + a;
                if (p < 1) requestAnimationFrame(tk);
              })(performance.now());
            }, i * 120);
          });
          sio.unobserve(en.target);
        }
      });
    }, { threshold: 0.3 });
    var bar = document.querySelector('.hs-bar-wrap');
    if (bar) sio.observe(bar);
  })();

  // Footer reveal on scroll & orb parallax
  (function(){
    var io = new IntersectionObserver(function(e){
      e.forEach(function(en){
        if(en.isIntersecting){ en.target.classList.add('v'); io.unobserve(en.target); }
      });
    }, { threshold: 0.05 });
    document.querySelectorAll('.ft-rv').forEach(function(el){ io.observe(el); });

    if (!('ontouchstart' in window)) {
      var ft = document.querySelector('.ft'), orbs = ft ? ft.querySelectorAll('.ft-orb') : [], tick = false;
      if (ft) {
        ft.addEventListener('mousemove', function(e){
          if (tick) return;
          tick = true;
          requestAnimationFrame(function(){
            var r = ft.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
            orbs.forEach(function(o, i){
              var s = (i + 1) * 7;
              o.style.transform = 'translate(' + x * s + 'px,' + y * s + 'px)';
              o.style.transition = 'transform 1.6s cubic-bezier(.16,1,.3,1)';
            });
            tick = false;
          });
        }, { passive: true });
      }
    }
  })();
  </script>
</body>
</html>
