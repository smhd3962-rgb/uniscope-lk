<%- include('partials/head', { title: "Privacy Policy - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding: 100px 20px 80px; color:var(--text-main);">
  <div class="container uniscope-card" style="max-width: 800px; padding:36px;">
    <h1 style="font-family:'DM Serif Display',serif; font-size: clamp(26px, 4vw, 32px); font-weight: 400; color:var(--text-main); margin-bottom: 16px;">
      Privacy Policy
    </h1>
    
    <div style="display:flex; flex-direction:column; gap:16px; font-size:14.5px; color:var(--text-secondary); line-height:1.75;">
      <p>
        <strong>1. Information Collection:</strong> UniScope LK respects your privacy. When using our public tools (Cut-Off Tracker, Subject Combinations, Degree Comparison), no personally identifiable information (PII) is required.
      </p>

      <p>
        <strong>2. Local Storage:</strong> We use your browser's local storage solely to remember your theme preference (Light/Dark mode) and saved degrees in your Degree Cart. This data remains on your personal device.
      </p>

      <p>
        <strong>3. User Accounts:</strong> If you voluntarily register an account, your email address is encrypted and used only for authentication and shortlisted degree sync. We will never sell, lease, or distribute your email to third-party commercial marketing entities.
      </p>

      <p>
        <strong>4. Contact:</strong> For any privacy-related requests, please contact privacy@uniscope.lk.
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
