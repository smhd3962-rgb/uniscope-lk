<script>
function switchDsTab(tabId, btn) {
  var tabs = ['overview', 'sources', 'method', 'airisk', 'tools', 'vision', 'assets'];
  tabs.forEach(function(t) {
    var el = document.getElementById('tab-' + t);
    if (el) el.classList.add('hidden-tab');
  });
  document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
  var activeEl = document.getElementById('tab-' + tabId);
  if (activeEl) activeEl.classList.remove('hidden-tab');
  if (btn) btn.classList.add('active');
}
</script>
