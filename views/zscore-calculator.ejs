<%- include('partials/head', { title: "Z-Score Eligibility Calculator - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding: 100px 20px 80px; color:var(--text-main);">
  <div class="container" style="max-width: 1050px;">
    
    <div style="text-align:center; margin-bottom: 32px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:var(--apple-blue-subtle); color:var(--apple-blue); padding:4px 14px; border-radius:980px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:12px; border:1px solid rgba(0,113,227,0.2);">
        Official UGC <%= typeof latestYear !== 'undefined' ? latestYear : '2025/2026' %> Admissions Model
      </div>
      <h1 style="font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif; font-size: clamp(28px, 4vw, 38px); font-weight: 700; letter-spacing:-0.03em; color:var(--text-main); margin-bottom: 8px;">
        Z-Score Eligibility Calculator
      </h1>
      <p style="color:var(--text-secondary); font-size: 15.5px; max-width: 650px; margin: 0 auto; line-height:1.55;">
        Instant multi-district qualification predictor across official UGC-approved degree programmes based on <%= typeof latestYear !== 'undefined' ? latestYear : '2025/2026' %> minimum selection thresholds.
      </p>
    </div>

    <!-- Calculator Input Box -->
    <div class="uniscope-card" style="padding:32px; margin-bottom:30px; border-radius:var(--radius-xl);">
      <form method="GET" action="/zscore-calculator/" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; align-items:flex-end;">
        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">Your A/L Stream</label>
          <select name="stream" required class="uniscope-select">
            <option value="">Select Stream</option>
            <option value="Physical Science" <%= stream === 'Physical Science' ? 'selected' : '' %>>Physical Science (Maths)</option>
            <option value="Bio Science" <%= stream === 'Bio Science' ? 'selected' : '' %>>Biological Science</option>
            <option value="Commerce" <%= stream === 'Commerce' ? 'selected' : '' %>>Commerce</option>
            <option value="Technology" <%= stream === 'Technology' ? 'selected' : '' %>>Technology</option>
            <option value="Arts" <%= stream === 'Arts' ? 'selected' : '' %>>Arts</option>
          </select>
        </div>

        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">District of Eligibility</label>
          <select name="district" required class="uniscope-select">
            <option value="">Select District</option>
            <% districts.forEach(function(d) { %>
              <option value="<%= d %>" <%= district === d ? 'selected' : '' %>><%= d %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">Your Official Z-Score</label>
          <input type="number" step="0.0001" name="zscore" required value="<%= zscore || '' %>" placeholder="e.g. 1.8420" class="uniscope-input">
        </div>

        <div>
          <button type="submit" class="btn-primary" style="width:100%; height:44px; display:inline-flex; align-items:center; justify-content:center; font-weight:600; border-radius:12px; cursor:pointer;">
            Calculate Eligibility
          </button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <% if (hasCalculated) { %>
      <div style="display:flex; flex-direction:column; gap:24px;">
        
        <!-- Category 1: High Probability -->
        <div class="uniscope-card" style="border-color:rgba(16,185,129,0.3); overflow:hidden; border-radius:var(--radius-xl);">
          <div style="background:rgba(16,185,129,0.08); padding:18px 24px; border-bottom:1px solid rgba(16,185,129,0.2); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h3 style="font-size:16px; font-weight:700; color:#10b981; margin:0; display:flex; align-items:center; gap:8px;">
              <span style="width:10px; height:10px; border-radius:50%; background:#10b981; display:inline-block;"></span>
              High Probability / Confirmed Qualifications (<%= confirmed.length %>)
            </h3>
            <span style="font-size:12px; font-weight:700; color:#10b981; background:var(--bg-card); border:1px solid rgba(16,185,129,0.3); padding:4px 12px; border-radius:980px;">
              Your Z-Score exceeds cutoff (+0.05 margin)
            </span>
          </div>
          <div style="padding:22px;">
            <% if (confirmed.length > 0) { %>
              <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:14px;">
                <% confirmed.forEach(function(c) { %>
                  <div class="uniscope-card" style="padding:16px; background:var(--bg-card-subtle); display:flex; justify-content:space-between; align-items:center; gap:12px; border-radius:14px;">
                    <div>
                      <div style="font-weight:700; color:var(--text-main); font-size:14px;"><%= c.course_name %></div>
                      <div style="font-size:12.5px; color:var(--text-secondary); margin-top:4px;">
                        Cutoff: <%= typeof c.min_zscore === 'number' ? c.min_zscore.toFixed(4) : c.min_zscore %> 
                        <% if (typeof c.min_zscore === 'number') { %>
                          (Lead: <strong style="color:#10b981;">+<%= (z - c.min_zscore).toFixed(4) %></strong>)
                        <% } %>
                      </div>
                    </div>
                    <button class="dg-cart-btn btn-calc-action" data-uni-code="<%= c.course_code %>" style="border:none; background:rgba(16,185,129,0.15); color:#10b981; padding:6px 12px; border-radius:8px; font-weight:700; font-size:12px; cursor:pointer; flex-shrink:0;">
                      + Cart
                    </button>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p style="color:var(--text-muted); font-size:14px; margin:0;">No degrees confirmed in this high-probability threshold bracket for <%= district %>.</p>
            <% } %>
          </div>
        </div>

        <!-- Category 2: Competitive Target Range -->
        <div class="uniscope-card" style="border-color:rgba(245,158,11,0.3); overflow:hidden; border-radius:var(--radius-xl);">
          <div style="background:rgba(245,158,11,0.08); padding:18px 24px; border-bottom:1px solid rgba(245,158,11,0.2); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h3 style="font-size:16px; font-weight:700; color:#f59e0b; margin:0; display:flex; align-items:center; gap:8px;">
              <span style="width:10px; height:10px; border-radius:50%; background:#f59e0b; display:inline-block;"></span>
              Competitive / Target Range (<%= competitive.length %>)
            </h3>
            <span style="font-size:12px; font-weight:700; color:#f59e0b; background:var(--bg-card); border:1px solid rgba(245,158,11,0.3); padding:4px 12px; border-radius:980px;">
              Within ±0.05 Z-Score Margin
            </span>
          </div>
          <div style="padding:22px;">
            <% if (competitive.length > 0) { %>
              <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:14px;">
                <% competitive.forEach(function(c) { %>
                  <div class="uniscope-card" style="padding:16px; background:var(--bg-card-subtle); display:flex; justify-content:space-between; align-items:center; gap:12px; border-radius:14px;">
                    <div>
                      <div style="font-weight:700; color:var(--text-main); font-size:14px;"><%= c.course_name %></div>
                      <div style="font-size:12.5px; color:var(--text-secondary); margin-top:4px;">
                        Cutoff: <%= typeof c.min_zscore === 'number' ? c.min_zscore.toFixed(4) : c.min_zscore %> 
                        <% if (typeof c.min_zscore === 'number') { %>
                          (Margin: <strong style="color:#f59e0b;"><%= (z - c.min_zscore).toFixed(4) %></strong>)
                        <% } %>
                      </div>
                    </div>
                    <button class="dg-cart-btn btn-calc-action" data-uni-code="<%= c.course_code %>" style="border:none; background:rgba(245,158,11,0.15); color:#f59e0b; padding:6px 12px; border-radius:8px; font-weight:700; font-size:12px; cursor:pointer; flex-shrink:0;">
                      + Cart
                    </button>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p style="color:var(--text-muted); font-size:14px; margin:0;">No degrees in this borderline target bracket for <%= district %>.</p>
            <% } %>
          </div>
        </div>

      </div>
    <% } %>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>