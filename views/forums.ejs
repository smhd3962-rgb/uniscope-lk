<%- include('partials/head', { title: "Student Resources & Educational Guides - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding: 100px 20px 80px; color:var(--text-main);">
  <div class="container" style="max-width: 1050px;">
    
    <div style="text-align:center; margin-bottom: 36px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:var(--apple-blue-subtle); color:var(--apple-blue); padding:4px 14px; border-radius:980px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:12px; border:1px solid rgba(0,113,227,0.2);">
        Educational Knowledge Base
      </div>
      <h1 style="font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif; font-size: clamp(28px, 4vw, 38px); font-weight: 700; letter-spacing:-0.03em; color:var(--text-main); margin-bottom: 8px;">
        Student Resources &amp; Guides
      </h1>
      <p style="color:var(--text-secondary); font-size: 15.5px; max-width: 650px; margin: 0 auto; line-height:1.55;">
        Verified reference materials, handbook downloads, bursary information, and admissions explainers for Sri Lankan students.
      </p>
    </div>

    <!-- 4 Key Resource Guides -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:20px; margin-bottom:32px;">
      
      <!-- Card 1: UGC Handbook -->
      <div class="uniscope-card" style="padding:26px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <div style="width:40px; height:40px; border-radius:10px; background:var(--apple-blue-subtle); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
          </div>
          <h3 style="font-size:18px; font-weight:700; color:var(--text-main); margin:0 0 8px;">UGC Student Handbook Guide</h3>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin-bottom:16px;">
            Understanding minimum general requirements, 3 passes in one sitting, common general test requirements, and English language eligibility.
          </p>
        </div>
        <a href="/data-sources/#tab-sources" class="apple-link" style="color:var(--apple-blue); font-weight:600; font-size:13.5px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
          View Handbook Verification <span>→</span>
        </a>
      </div>

      <!-- Card 2: District Quota Mechanism -->
      <div class="uniscope-card" style="padding:26px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <div style="width:40px; height:40px; border-radius:10px; background:var(--apple-blue-subtle); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
            </svg>
          </div>
          <h3 style="font-size:18px; font-weight:700; color:var(--text-main); margin:0 0 8px;">District Quotas (40% - 55% - 5%)</h3>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin-bottom:16px;">
            How seats are apportioned between all-island national merit (40%), district population quota (55%), and 16 economically disadvantaged educationally underdeveloped districts (5%).
          </p>
        </div>
        <a href="/faq/" class="apple-link" style="color:var(--apple-blue); font-weight:600; font-size:13.5px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
          Read Quota FAQs <span>→</span>
        </a>
      </div>

      <!-- Card 3: Mahapola & University Bursaries -->
      <div class="uniscope-card" style="padding:26px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <div style="width:40px; height:40px; border-radius:10px; background:var(--apple-blue-subtle); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <h3 style="font-size:18px; font-weight:700; color:var(--text-main); margin:0 0 8px;">Mahapola &amp; State Bursaries</h3>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin-bottom:16px;">
            Criteria for Mahapola Higher Education Scholarship Trust Fund awards (Merit vs Ordinary categories) and institutional university bursaries for enrolled undergraduates.
          </p>
        </div>
        <a href="https://www.ugc.ac.lk/" target="_blank" rel="noopener" class="apple-link" style="color:var(--apple-blue); font-weight:600; font-size:13.5px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
          Official UGC Financial Aid <span>→</span>
        </a>
      </div>

      <!-- Card 4: GPA & Academic Progress -->
      <div class="uniscope-card" style="padding:26px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <div style="width:40px; height:40px; border-radius:10px; background:var(--apple-blue-subtle); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <rect x="4" y="2" width="16" height="20" rx="2"/>
              <line x1="8" y1="6" x2="16" y2="6"/>
            </svg>
          </div>
          <h3 style="font-size:18px; font-weight:700; color:var(--text-main); margin:0 0 8px;">GPA Scales &amp; Honours Classes</h3>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin-bottom:16px;">
            Detailed breakdown of UoM 4.2 vs UGC 4.0 grading scales, First Class (3.70+), Second Upper (3.30+), Second Lower (3.00+), repeat exam grade caps, and non-GPA module handling.
          </p>
        </div>
        <a href="/gpa-calculator/" class="apple-link" style="color:var(--apple-blue); font-weight:600; font-size:13.5px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
          Launch GPA Calculator <span>→</span>
        </a>
      </div>

    </div>

    <!-- Frequently Asked Questions -->
    <div class="uniscope-card" style="padding:32px; border-radius:var(--radius-xl);">
      <h3 style="font-size:20px; font-weight:700; color:var(--text-main); margin-bottom:18px;">
        Frequently Asked Admissions Questions
      </h3>

      <div style="display:flex; flex-direction:column; gap:16px;">
        <div style="padding:16px 20px; background:var(--bg-card-subtle); border-radius:12px; border:1px solid var(--border-subtle);">
          <h4 style="font-size:15px; font-weight:700; color:var(--text-main); margin:0 0 6px;">
            What does "NQC" mean in official UGC Cut-Off tables?
          </h4>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin:0;">
            "NQC" stands for <em>No Qualified Candidates</em>. It indicates that no candidate from that administrative district satisfied the minimum qualification criteria or applied for that specific degree course in that admissions round.
          </p>
        </div>

        <div style="padding:16px 20px; background:var(--bg-card-subtle); border-radius:12px; border:1px solid var(--border-subtle);">
          <h4 style="font-size:15px; font-weight:700; color:var(--text-main); margin:0 0 6px;">
            Does exceeding last year's cut-off mark guarantee admission this year?
          </h4>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin:0;">
            No. Cut-off marks are historical records of the lowest Z-Score selected in a past cohort. They reflect candidate performance, total seat allocations, and district applicant volumes for that year only.
          </p>
        </div>

        <div style="padding:16px 20px; background:var(--bg-card-subtle); border-radius:12px; border:1px solid var(--border-subtle);">
          <h4 style="font-size:15px; font-weight:700; color:var(--text-main); margin:0 0 6px;">
            How is a student's administrative district determined for UGC admissions?
          </h4>
          <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin:0;">
            Under UGC regulations, your district of eligibility is determined by the district where you studied for the minimum qualifying period during senior secondary school, not simply where you sat the exam or currently reside. See our <a href="/faq/" style="color:var(--apple-blue); font-weight:600;">Admissions FAQ</a> for complete rules.
          </p>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>