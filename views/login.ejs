<%- include('partials/head', { title: "Login - UniScope LK" }) %>
<%- include('partials/navbar') %>

<link rel="stylesheet" href="/static/accounts/css/auth.css">

<div class="auth-container">
    <div class="auth-card">
        <div style="text-align:center; margin-bottom: 22px;">
            <a href="/" title="Return to UniScope LK Home">
                <img src="/static/home/images/uniscope_logo_full.png" alt="UniScope LK" style="height:44px; width:auto; max-width:85%; object-fit:contain;">
            </a>
        </div>
        <div class="auth-header">
            <h1>Welcome Back</h1>
            <p>Log in to your UniScope LK student account</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="auth-error">
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/accounts/login/" class="auth-form" data-testid="form-login">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" value="" required placeholder="Enter your email" data-testid="input-email" class="uniscope-input">
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-wrapper" style="position:relative;">
                    <input type="password" id="password" name="password" required placeholder="Enter your password" data-testid="input-password" class="uniscope-input" style="padding-right: 44px;">
                    <button type="button" class="toggle-password" onclick="togglePassword('password', this)" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:var(--text-muted);" aria-label="Toggle password visibility">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>

            <div class="form-options" style="display:flex; justify-content:flex-end;">
                <button type="button" onclick="alert('Password reset instructions will be sent to your registered email.')" class="forgot-link" style="color:#7c3aed; font-size:13px; font-weight:600; text-decoration:none; background:none; border:none; cursor:pointer; padding:0;">Forgot Password?</button>
            </div>

            <button type="submit" class="btn-calc-action" data-testid="button-login" style="background:linear-gradient(135deg,#3b4fa8,#7c3aed); color:#fff; border:none; padding:12px; border-radius:10px; font-weight:700; font-size:15px; cursor:pointer; margin-top:6px; width:100%;">
              Log In
            </button>
        </form>

        <div class="auth-divider">
            <hr>
            <span>or</span>
        </div>

        <a href="/accounts/google/login/" class="google-btn">
            <svg viewBox="0 0 24 24" width="18" height="18">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Continue with Google
        </a>

        <p class="auth-switch">
            Don't have an account? <a href="/accounts/register/" style="color:#7c3aed; font-weight:700; text-decoration:none;" data-testid="link-register">Sign Up Free</a>
        </p>
    </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>

<script>
function togglePassword(fieldId, btn) {
    var f = document.getElementById(fieldId);
    if (f.type === 'password') {
        f.type = 'text';
    } else {
        f.type = 'password';
    }
}
</script>
