<%- include('partials/head', { title: "University Cost-of-Living Planner - UniScope LK" }) %>
<%- include('partials/navbar') %>

<style>
.cost-page {
  background: var(--bg-page);
  min-height: 100vh;
  padding: 110px 20px 80px;
  color: var(--text-main);
}

.cost-container {
  max-width: 1240px;
  margin: 0 auto;
}

/* Hero Section */
.cost-hero {
  text-align: center;
  max-width: 860px;
  margin: 0 auto 36px;
}

.cost-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(16, 185, 129, 0.08);
  color: #10b981;
  padding: 6px 18px;
  border-radius: 980px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 14px;
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.cost-title {
  font-size: clamp(30px, 4.2vw, 44px);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 12px;
  color: var(--text-main);
}

.cost-subtitle {
  font-size: clamp(16px, 2vw, 19px);
  color: var(--text-muted, #64748b);
  line-height: 1.5;
  margin-bottom: 24px;
}

/* Location and Preset Bar */
.cost-preset-card {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 20px;
  padding: 20px 24px;
  margin-bottom: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  box-shadow: 0 4px 18px rgba(0,0,0,0.03);
}
[data-theme="dark"] .cost-preset-card,
body.dark .cost-preset-card {
  background: #161f36;
  border-color: #273553;
}

.cost-preset-group {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.cost-select {
  padding: 10px 16px;
  border-radius: 12px;
  border: 1px solid var(--border-color, #cbd5e1);
  background: var(--bg-page, #ffffff);
  color: var(--text-main);
  font-size: 14px;
  font-weight: 600;
  outline: none;
  font-family: inherit;
  cursor: pointer;
}
.cost-select:focus {
  border-color: var(--apple-blue);
}

.cost-preset-btn {
  padding: 8px 14px;
  border-radius: 10px;
  border: 1px solid var(--border-color);
  background: var(--card-bg);
  color: var(--text-main);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 160ms ease;
  font-family: inherit;
}
.cost-preset-btn:hover {
  border-color: var(--apple-blue);
  color: var(--apple-blue);
}
.cost-preset-btn.active {
  background: var(--apple-blue);
  color: #fff;
  border-color: var(--apple-blue);
}

/* Main Grid Layout */
.cost-layout {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 30px;
  align-items: start;
}
@media (max-width: 1024px) {
  .cost-layout {
    grid-template-columns: 1fr;
  }
}

/* Sections & Form Cards */
.cost-card {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 20px;
  padding: 24px;
  margin-bottom: 24px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}
[data-theme="dark"] .cost-card,
body.dark .cost-card {
  background: #161f36;
  border-color: #273553;
}

.cost-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-color, #e2e8f0);
}
.cost-card-title {
  font-size: 17.5px;
  font-weight: 700;
  color: var(--text-main);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.cost-card-sub {
  font-size: 13px;
  color: var(--text-muted);
}

/* Input Fields Grid */
.cost-inputs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media (max-width: 640px) {
  .cost-inputs-grid {
    grid-template-columns: 1fr;
  }
}

.cost-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.cost-field label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-main);
  display: flex;
  justify-content: space-between;
}
.cost-field-sub {
  font-size: 11px;
  color: var(--text-muted);
  font-weight: 400;
}
.cost-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.cost-curr-prefix {
  position: absolute;
  left: 12px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-muted);
  pointer-events: none;
}
.cost-input {
  width: 100%;
  padding: 10px 14px 10px 48px;
  border-radius: 12px;
  border: 1px solid var(--border-color, #cbd5e1);
  background: var(--bg-page, #f8fafc);
  color: var(--text-main);
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  outline: none;
  transition: all 160ms ease;
}
.cost-input:focus {
  border-color: var(--apple-blue);
  background: var(--card-bg, #ffffff);
  box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
}

/* Sticky Summary Card */
.cost-summary-card {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 24px;
  padding: 26px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  position: sticky;
  top: 90px;
}
[data-theme="dark"] .cost-summary-card,
body.dark .cost-summary-card {
  background: #161f36;
  border-color: #273553;
}

.cost-sum-eyebrow {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  margin-bottom: 6px;
}
.cost-sum-total {
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--apple-blue, #0071e3);
  margin-bottom: 4px;
}
.cost-sum-period {
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 20px;
}

/* Stat row cards */
.cost-stat-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 20px;
}
.cost-stat-box {
  background: var(--bg-page, #f8fafc);
  padding: 14px;
  border-radius: 14px;
  border: 1px solid var(--border-color, rgba(0,0,0,0.04));
}
.cost-stat-lbl {
  font-size: 11.5px;
  color: var(--text-muted);
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 4px;
}
.cost-stat-val {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-main);
}
.cost-stat-val.positive {
  color: #10b981;
}
.cost-stat-val.negative {
  color: #ef4444;
}

/* Balance Banner */
.cost-balance-banner {
  padding: 14px 18px;
  border-radius: 14px;
  margin-bottom: 22px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 13.5px;
  font-weight: 600;
}
.cost-balance-banner.surplus {
  background: rgba(16, 185, 129, 0.1);
  color: #059669;
  border: 1px solid rgba(16, 185, 129, 0.25);
}
.cost-balance-banner.deficit {
  background: rgba(239, 68, 68, 0.1);
  color: #dc2626;
  border: 1px solid rgba(239, 68, 68, 0.25);
}

/* Dynamic Chart */
.cost-chart-wrap {
  margin-bottom: 20px;
  text-align: center;
}
.cost-svg-chart {
  max-width: 220px;
  margin: 0 auto 12px;
}
.cost-chart-legend {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 12px;
  text-align: left;
  font-size: 12px;
}
.cost-legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-muted);
}
.cost-legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* Summary Actions */
.cost-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.cost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 18px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 160ms ease;
  font-family: inherit;
}
.cost-btn-primary {
  background: var(--apple-blue, #0071e3);
  color: #ffffff;
}
.cost-btn-primary:hover {
  background: #0060c2;
}
.cost-btn-outline {
  background: transparent;
  color: var(--text-main);
  border-color: var(--border-color);
}
.cost-btn-outline:hover {
  border-color: var(--apple-blue);
  color: var(--apple-blue);
}

/* Comparison Section */
.cost-compare-drawer {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 20px;
  padding: 24px;
  margin-top: 30px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}
[data-theme="dark"] .cost-compare-drawer,
body.dark .cost-compare-drawer {
  background: #161f36;
  border-color: #273553;
}
.cost-compare-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 16px;
}
@media (max-width: 640px) {
  .cost-compare-grid {
    grid-template-columns: 1fr;
  }
}
.cost-compare-col {
  background: var(--bg-page, #f8fafc);
  padding: 20px;
  border-radius: 16px;
  border: 1px solid var(--border-color);
}

/* Data source notice */
.cost-source-notice {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 16px;
  padding: 18px 22px;
  margin-top: 30px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-muted);
}
[data-theme="dark"] .cost-source-notice,
body.dark .cost-source-notice {
  background: #161f36;
  border-color: #273553;
}
.cost-source-notice strong {
  color: var(--text-main);
}

@media print {
  .navbar, .footer, .cost-preset-card, .cost-actions, .cost-compare-drawer {
    display: none !important;
  }
  .cost-page {
    padding: 0 !important;
    background: #fff !important;
    color: #000 !important;
  }
  .cost-layout {
    grid-template-columns: 1fr 1fr !important;
  }
}
</style>

<div class="cost-page">
  <div class="cost-container">

    <!-- Hero Header -->
    <div class="cost-hero">
      <div class="cost-eyebrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        Student Financial Tool
      </div>
      <h1 class="cost-title">University Cost-of-Living Planner</h1>
      <div class="cost-subtitle">
        Plan, budget, and estimate your monthly university expenses across Sri Lankan state universities and study locations.
      </div>
    </div>

    <!-- Location & Scenario Presets -->
    <div class="cost-preset-card">
      <div class="cost-preset-group">
        <label for="citySelect" style="font-size:13.5px; font-weight:700; color:var(--text-main);">Campus / Location:</label>
        <select id="citySelect" class="cost-select" onchange="onLocationChange()">
          <option value="colombo">Colombo / Greater Colombo (UoC, USJ, Kelaniya, Moratuwa)</option>
          <option value="kandy">Kandy / Peradeniya (University of Peradeniya)</option>
          <option value="galle_matara">Galle &amp; Matara (University of Ruhuna)</option>
          <option value="jaffna">Jaffna &amp; Kilinochchi (University of Jaffna)</option>
          <option value="kurunegala">Kurunegala / Kuliyapitiya (Wayamba University)</option>
          <option value="anuradhapura">Anuradhapura / Mihintale (Rajarata University)</option>
          <option value="batticaloa">Batticaloa &amp; Trincomalee (Eastern University)</option>
          <option value="oluvil">Oluvil / Sammanthurai (South Eastern University)</option>
          <option value="belihuloya">Belihuloya / Balangoda (Sabaragamuwa University)</option>
          <option value="badulla">Badulla (Uva Wellassa University)</option>
          <option value="custom">Custom Location</option>
        </select>
      </div>

      <div class="cost-preset-group">
        <span style="font-size:13px; font-weight:600; color:var(--text-muted);">Quick-Fill Scenario:</span>
        <button class="cost-preset-btn" onclick="applyScenario('hostel', this)" title="University Subsidized Hostel">Hostel (Basic)</button>
        <button class="cost-preset-btn active" onclick="applyScenario('shared', this)" title="Shared Private Bodim / Room">Shared Bodim (Standard)</button>
        <button class="cost-preset-btn" onclick="applyScenario('private', this)" title="Private Annex or Single Room">Private Annex (Comfortable)</button>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="cost-layout">

      <!-- Left Column: Inputs -->
      <div class="cost-forms">

        <!-- Card 1: Monthly Expenses -->
        <div class="cost-card">
          <div class="cost-card-header">
            <div>
              <h3 class="cost-card-title">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Monthly Living Expenses
              </h3>
              <div class="cost-card-sub">Enter your estimated monthly outflows in Sri Lankan Rupees (LKR)</div>
            </div>
            <button class="cost-preset-btn" onclick="resetExpenses()" style="font-size:12px; padding:6px 12px;">Clear All</button>
          </div>

          <div class="cost-inputs-grid">

            <div class="cost-field">
              <label for="exp_rent">Accommodation / Hostel Rent <span class="cost-field-sub">Monthly rent</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_rent" class="cost-input" value="12000" min="0" step="500" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_food">Food &amp; Groceries <span class="cost-field-sub">Meals, canteens, tea</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_food" class="cost-input" value="18000" min="0" step="500" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_trans">Transportation <span class="cost-field-sub">Bus, train season, rides</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_trans" class="cost-input" value="4500" min="0" step="250" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_data">Internet &amp; Mobile Data <span class="cost-field-sub">Broadband / 4G packages</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_data" class="cost-input" value="2500" min="0" step="100" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_study">Study Materials &amp; Books <span class="cost-field-sub">Textbooks, instruments</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_study" class="cost-input" value="2000" min="0" step="250" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_print">Printing &amp; Stationery <span class="cost-field-sub">Photocopying, binding</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_print" class="cost-input" value="1500" min="0" step="100" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_util">Electricity &amp; Utilities <span class="cost-field-sub">Water, boarding bills</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_util" class="cost-input" value="1800" min="0" step="100" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_pers">Personal Expenses <span class="cost-field-sub">Toiletries, laundry</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_pers" class="cost-input" value="3000" min="0" step="250" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_med">Medical &amp; Miscellaneous <span class="cost-field-sub">Doctor, medicines</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_med" class="cost-input" value="1500" min="0" step="250" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="exp_other">Other Emergency Expenses <span class="cost-field-sub">Contingency fund</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="exp_other" class="cost-input" value="2000" min="0" step="250" oninput="calculateBudget()">
              </div>
            </div>

          </div>
        </div>

        <!-- Card 2: Monthly Income & Support -->
        <div class="cost-card">
          <div class="cost-card-header">
            <div>
              <h3 class="cost-card-title">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Monthly Income &amp; Financial Support
              </h3>
              <div class="cost-card-sub">Specify family support, scholarships, bursaries, or earnings</div>
            </div>
            <button class="cost-preset-btn" onclick="resetIncome()" style="font-size:12px; padding:6px 12px;">Clear All</button>
          </div>

          <div class="cost-inputs-grid">

            <div class="cost-field">
              <label for="inc_family">Family / Parental Contribution <span class="cost-field-sub">Monthly allowance</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="inc_family" class="cost-input" value="35000" min="0" step="1000" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="inc_mahapola">Mahapola / University Bursary <span class="cost-field-sub">Govt scholarship</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="inc_mahapola" class="cost-input" value="5000" min="0" step="500" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="inc_work">Part-Time Work / Freelancing <span class="cost-field-sub">Tutoring, coding, jobs</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="inc_work" class="cost-input" value="5000" min="0" step="500" oninput="calculateBudget()">
              </div>
            </div>

            <div class="cost-field">
              <label for="inc_other">Other Grants / Educational Loans <span class="cost-field-sub">Trust funds, IFSLS</span></label>
              <div class="cost-input-wrap">
                <span class="cost-curr-prefix">Rs.</span>
                <input type="number" id="inc_other" class="cost-input" value="0" min="0" step="500" oninput="calculateBudget()">
              </div>
            </div>

          </div>
        </div>

        <!-- Academic Duration Selector -->
        <div class="cost-card" style="padding:18px 24px;">
          <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div>
              <div style="font-size:14.5px; font-weight:700; color:var(--text-main);">Annual Period Duration:</div>
              <div style="font-size:12.5px; color:var(--text-muted);">Adjust for semester breaks or full calendar year (10 or 12 months)</div>
            </div>
            <select id="durationSelect" class="cost-select" onchange="calculateBudget()">
              <option value="10">10 Months (Standard Academic Year)</option>
              <option value="12" selected>12 Months (Full Calendar Year)</option>
              <option value="8">8 Months (Two Standard Semesters)</option>
              <option value="6">6 Months (One Semester)</option>
            </select>
          </div>
        </div>

      </div>

      <!-- Right Column: Live Calculation Summary & Charts -->
      <div class="cost-summary-col">

        <div class="cost-summary-card">
          <div class="cost-sum-eyebrow">Estimated Monthly Expenses</div>
          <div class="cost-sum-total" id="sumMonthlyExpenses">Rs. 48,800</div>
          <div class="cost-sum-period">
            Annual: <strong id="sumAnnualExpenses">Rs. 585,600</strong> (<span id="sumDurationText">12 months</span>)
          </div>

          <div class="cost-stat-cards">
            <div class="cost-stat-box">
              <div class="cost-stat-lbl">Monthly Income</div>
              <div class="cost-stat-val" id="sumMonthlyIncome">Rs. 45,000</div>
            </div>
            <div class="cost-stat-box">
              <div class="cost-stat-lbl">Monthly Balance</div>
              <div class="cost-stat-val" id="sumMonthlyBalance">-Rs. 3,800</div>
            </div>
          </div>

          <!-- Balance Health Banner -->
          <div class="cost-balance-banner deficit" id="balanceBanner">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="balanceText">Shortfall of Rs. 3,800 / month. Consider university hostel or bursary.</span>
          </div>

          <!-- Dynamic SVG Donut Chart -->
          <div class="cost-chart-wrap">
            <svg class="cost-svg-chart" viewBox="0 0 100 100" id="costDonutSvg">
              <!-- Rendered via JS -->
            </svg>
            <div class="cost-chart-legend" id="costLegend">
              <!-- Rendered via JS -->
            </div>
          </div>

          <div class="cost-actions">
            <button class="cost-btn cost-btn-primary" onclick="saveBudgetLocal()">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Save Budget Locally
            </button>
            <button class="cost-btn cost-btn-outline" onclick="window.print()">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
              Print / Save PDF Summary
            </button>
          </div>

        </div>

      </div>

    </div>

    <!-- Scenario Comparison Feature -->
    <div class="cost-compare-drawer">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <div>
          <h3 style="font-size:18px; font-weight:700; margin:0 0 4px; color:var(--text-main);">Budget Scenario Comparison</h3>
          <p style="font-size:13px; color:var(--text-muted); margin:0;">Compare university hostel living against private boarding house accommodation.</p>
        </div>
        <button class="cost-preset-btn" onclick="toggleCompareMode()" id="compareToggleBtn">Compare Hostel vs Bodim</button>
      </div>

      <div class="cost-compare-grid" id="compareGrid" style="display:none;">
        <div class="cost-compare-col">
          <div style="font-size:12px; font-weight:700; color:#10b981; text-transform:uppercase;">Option A: University Hostel</div>
          <div style="font-size:22px; font-weight:800; color:var(--text-main); margin:6px 0;">Rs. 24,000 <span style="font-size:13px; font-weight:500; color:var(--text-muted);">/ month</span></div>
          <p style="font-size:13px; color:var(--text-muted); line-height:1.5;">Subsidized campus hostel accommodation (Rs. 1,500/mo), university canteen meals (Rs. 14,000/mo), minimal transit on foot.</p>
          <div style="font-size:13px; font-weight:700; color:var(--text-main); margin-top:10px;">Annual: Rs. 288,000 (12 mos)</div>
        </div>

        <div class="cost-compare-col">
          <div style="font-size:12px; font-weight:700; color:#0071e3; text-transform:uppercase;">Option B: Private Boarding (Bodim)</div>
          <div style="font-size:22px; font-weight:800; color:var(--text-main); margin:6px 0;">Rs. 48,800 <span style="font-size:13px; font-weight:500; color:var(--text-muted);">/ month</span></div>
          <p style="font-size:13px; color:var(--text-muted); line-height:1.5;">Shared room in vicinity of faculty (Rs. 12,000/mo), groceries &amp; canteens, bus fare, utilities and broadband data.</p>
          <div style="font-size:13px; font-weight:700; color:var(--text-main); margin-top:10px;">Annual: Rs. 585,600 (12 mos)</div>
        </div>
      </div>
    </div>

    <!-- Data Transparency & Source Notice -->
    <div class="cost-source-notice">
      <strong>Illustrative Benchmark Disclosure:</strong>
      All expense amounts shown above are editable benchmarks for educational budgeting purposes.
      UniScope LK does not publish unverified city averages as definitive factual figures; student living expenses vary widely depending on personal lifestyle, location proximity to campus, and prevailing market rates.
      Hostel fees reflect state university subsidized accommodation guidelines.
      Mahapola Scholarship figures reflect official trust rates (Merit: Rs. 5,000 / Ordinary: Rs. 5,000 monthly).
    </div>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>

<script>
// Category colors for donut chart
const CATEGORY_COLORS = {
  rent: '#0071e3',
  food: '#10b981',
  trans: '#f59e0b',
  data: '#8b5cf6',
  study: '#06b6d4',
  print: '#ec4899',
  util: '#6366f1',
  pers: '#14b8a6',
  med: '#ef4444',
  other: '#64748b'
};

const CATEGORY_LABELS = {
  rent: 'Accommodation',
  food: 'Food & Meals',
  trans: 'Transport',
  data: 'Data / Internet',
  study: 'Study Books',
  print: 'Printing',
  util: 'Utilities',
  pers: 'Personal',
  med: 'Medical',
  other: 'Other'
};

// Illustrative Presets
const SCENARIOS = {
  hostel: {
    rent: 1500,
    food: 14000,
    trans: 1500,
    data: 1800,
    study: 1500,
    print: 1000,
    util: 500,
    pers: 2000,
    med: 1000,
    other: 1000
  },
  shared: {
    rent: 12000,
    food: 18000,
    trans: 4500,
    data: 2500,
    study: 2000,
    print: 1500,
    util: 1800,
    pers: 3000,
    med: 1500,
    other: 2000
  },
  private: {
    rent: 26000,
    food: 26000,
    trans: 8000,
    data: 4000,
    study: 3500,
    print: 2500,
    util: 4500,
    pers: 5000,
    med: 3000,
    other: 4000
  }
};

function formatLKR(val) {
  const num = Math.round(Number(val) || 0);
  return 'Rs. ' + num.toLocaleString('en-US');
}

function getVal(id) {
  const el = document.getElementById(id);
  if (!el) return 0;
  const v = parseFloat(el.value);
  return isNaN(v) || v < 0 ? 0 : v;
}

function calculateBudget() {
  const expRent = getVal('exp_rent');
  const expFood = getVal('exp_food');
  const expTrans = getVal('exp_trans');
  const expData = getVal('exp_data');
  const expStudy = getVal('exp_study');
  const expPrint = getVal('exp_print');
  const expUtil = getVal('exp_util');
  const expPers = getVal('exp_pers');
  const expMed = getVal('exp_med');
  const expOther = getVal('exp_other');

  const totalMonthlyExpenses = expRent + expFood + expTrans + expData + expStudy + expPrint + expUtil + expPers + expMed + expOther;

  const incFamily = getVal('inc_family');
  const incMahapola = getVal('inc_mahapola');
  const incWork = getVal('inc_work');
  const incOther = getVal('inc_other');

  const totalMonthlyIncome = incFamily + incMahapola + incWork + incOther;

  const duration = parseInt(document.getElementById('durationSelect').value) || 12;
  const annualExpenses = totalMonthlyExpenses * duration;
  const balance = totalMonthlyIncome - totalMonthlyExpenses;
  const shortfall = Math.max(0, totalMonthlyExpenses - totalMonthlyIncome);

  // Update UI Elements
  document.getElementById('sumMonthlyExpenses').textContent = formatLKR(totalMonthlyExpenses);
  document.getElementById('sumAnnualExpenses').textContent = formatLKR(annualExpenses);
  document.getElementById('sumDurationText').textContent = `${duration} months`;
  document.getElementById('sumMonthlyIncome').textContent = formatLKR(totalMonthlyIncome);

  const balEl = document.getElementById('sumMonthlyBalance');
  const banner = document.getElementById('balanceBanner');
  const bannerText = document.getElementById('balanceText');

  if (balance >= 0) {
    balEl.textContent = `+${formatLKR(balance)}`;
    balEl.className = 'cost-stat-val positive';
    banner.className = 'cost-balance-banner surplus';
    bannerText.innerHTML = `<strong>Surplus of ${formatLKR(balance)} / month.</strong> Your income comfortably covers living expenses.`;
  } else {
    balEl.textContent = `-${formatLKR(shortfall)}`;
    balEl.className = 'cost-stat-val negative';
    banner.className = 'cost-balance-banner deficit';
    bannerText.innerHTML = `<strong>Shortfall of ${formatLKR(shortfall)} / month.</strong> Consider subsidized hostels, student loans, or bursaries.`;
  }

  // Update Donut Chart
  renderDonutChart({
    rent: expRent,
    food: expFood,
    trans: expTrans,
    data: expData,
    study: expStudy,
    print: expPrint,
    util: expUtil,
    pers: expPers,
    med: expMed,
    other: expOther
  }, totalMonthlyExpenses);
}

function renderDonutChart(expenses, total) {
  const svg = document.getElementById('costDonutSvg');
  const legend = document.getElementById('costLegend');
  if (!svg || !legend) return;

  if (total <= 0) {
    svg.innerHTML = `
      <circle cx="50" cy="50" r="38" fill="none" stroke="#e2e8f0" stroke-width="14"/>
      <text x="50" y="54" text-anchor="middle" font-size="9" fill="#94a3b8" font-weight="600">No Expenses</text>
    `;
    legend.innerHTML = '';
    return;
  }

  const radius = 38;
  const circumference = 2 * Math.PI * radius;
  let offset = 0;
  let svgPaths = '';
  let legendHtml = '';

  const entries = Object.entries(expenses).filter(([_, val]) => val > 0);

  entries.forEach(([cat, val]) => {
    const pct = (val / total);
    const strokeDasharray = `${pct * circumference} ${circumference}`;
    const color = CATEGORY_COLORS[cat] || '#64748b';

    svgPaths += `
      <circle cx="50" cy="50" r="${radius}" fill="none" stroke="${color}" stroke-width="14"
              stroke-dasharray="${strokeDasharray}" stroke-dashoffset="${-offset}"
              transform="rotate(-90 50 50)"/>
    `;
    offset += pct * circumference;

    const pctDisplay = Math.round(pct * 100);
    legendHtml += `
      <div class="cost-legend-item">
        <span class="cost-legend-dot" style="background:${color};"></span>
        <span>${CATEGORY_LABELS[cat]}: <strong>${pctDisplay}%</strong></span>
      </div>
    `;
  });

  // Center hole text
  svgPaths += `
    <circle cx="50" cy="50" r="28" fill="var(--card-bg, #ffffff)"/>
    <text x="50" y="48" text-anchor="middle" font-size="7.5" fill="var(--text-muted, #64748b)" font-weight="700">TOTAL</text>
    <text x="50" y="58" text-anchor="middle" font-size="9" fill="var(--text-main, #0f172a)" font-weight="800">${Math.round(total/1000)}k</text>
  `;

  svg.innerHTML = svgPaths;
  legend.innerHTML = legendHtml;
}

function applyScenario(scenarioKey, btn) {
  const data = SCENARIOS[scenarioKey];
  if (!data) return;

  document.querySelectorAll('.cost-preset-btn').forEach(b => {
    if (b.onclick && b.onclick.toString().includes('applyScenario')) {
      b.classList.remove('active');
    }
  });
  if (btn) btn.classList.add('active');

  for (const [k, v] of Object.entries(data)) {
    const el = document.getElementById(`exp_${k}`);
    if (el) el.value = v;
  }

  calculateBudget();
}

function onLocationChange() {
  const city = document.getElementById('citySelect').value;
  // If user picks a specific city, adjust standard rent baseline gently
  if (city === 'colombo') {
    document.getElementById('exp_rent').value = 14000;
  } else if (city === 'kandy') {
    document.getElementById('exp_rent').value = 11000;
  } else if (city === 'jaffna' || city === 'batticaloa') {
    document.getElementById('exp_rent').value = 9000;
  } else if (city === 'belihuloya' || city === 'badulla' || city === 'anuradhapura') {
    document.getElementById('exp_rent').value = 8500;
  }
  calculateBudget();
}

function resetExpenses() {
  ['rent', 'food', 'trans', 'data', 'study', 'print', 'util', 'pers', 'med', 'other'].forEach(k => {
    const el = document.getElementById(`exp_${k}`);
    if (el) el.value = 0;
  });
  calculateBudget();
}

function resetIncome() {
  ['family', 'mahapola', 'work', 'other'].forEach(k => {
    const el = document.getElementById(`inc_${k}`);
    if (el) el.value = 0;
  });
  calculateBudget();
}

function toggleCompareMode() {
  const grid = document.getElementById('compareGrid');
  const btn = document.getElementById('compareToggleBtn');
  if (grid.style.display === 'none') {
    grid.style.display = 'grid';
    btn.textContent = 'Hide Comparison';
  } else {
    grid.style.display = 'none';
    btn.textContent = 'Compare Hostel vs Bodim';
  }
}

function saveBudgetLocal() {
  try {
    const state = {
      city: document.getElementById('citySelect').value,
      duration: document.getElementById('durationSelect').value,
      expenses: {
        rent: getVal('exp_rent'),
        food: getVal('exp_food'),
        trans: getVal('exp_trans'),
        data: getVal('exp_data'),
        study: getVal('exp_study'),
        print: getVal('exp_print'),
        util: getVal('exp_util'),
        pers: getVal('exp_pers'),
        med: getVal('exp_med'),
        other: getVal('exp_other')
      },
      income: {
        family: getVal('inc_family'),
        mahapola: getVal('inc_mahapola'),
        work: getVal('inc_work'),
        other: getVal('inc_other')
      }
    };
    localStorage.setItem('uniscope_student_budget', JSON.stringify(state));
    alert('Your budget has been saved successfully in your browser!');
  } catch (e) {
    console.error('Failed to save budget:', e);
  }
}

function loadSavedBudget() {
  try {
    const raw = localStorage.getItem('uniscope_student_budget');
    if (!raw) return;
    const state = JSON.parse(raw);
    if (state.city) document.getElementById('citySelect').value = state.city;
    if (state.duration) document.getElementById('durationSelect').value = state.duration;
    if (state.expenses) {
      for (const [k, v] of Object.entries(state.expenses)) {
        const el = document.getElementById(`exp_${k}`);
        if (el) el.value = v;
      }
    }
    if (state.income) {
      for (const [k, v] of Object.entries(state.income)) {
        const el = document.getElementById(`inc_${k}`);
        if (el) el.value = v;
      }
    }
  } catch (e) {
    console.error('Failed to load budget:', e);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadSavedBudget();
  calculateBudget();
});
</script>
