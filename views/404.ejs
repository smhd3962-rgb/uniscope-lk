<%- include('partials/head', { title: "404 - Degree or Page Not Found | UniScope LK" }) %>
<%- include('partials/navbar') %>

<main class="page-content" style="min-height: 80vh; padding: 120px 20px 60px; display: flex; align-items: center; justify-content: center;">
  <div class="container" style="max-width: 760px; text-align: center;">
    <div class="uniscope-card" style="padding: 48px 32px; border-radius: 20px; box-shadow: 0 12px 40px rgba(0,0,0,0.06); text-align: center;">
      <div style="width: 80px; height: 80px; margin: 0 auto 24px; border-radius: 50%; background: var(--apple-blue-subtle); color: var(--apple-blue); display: flex; align-items: center; justify-content: center;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="36" height="36"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      
      <div style="display: inline-block; padding: 4px 14px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 20px; color: #ef4444; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 16px;">
        Error 404 · Page Not Found
      </div>
      
      <h1 style="font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--text-main, #0f172a); margin-bottom: 12px; line-height: 1.25;">
        Degree or Page Not Found
      </h1>
      
      <p style="font-size: 15px; color: var(--text-secondary, #64748b); max-width: 540px; margin: 0 auto 28px; line-height: 1.6;">
        We couldn't locate the exact degree course, calculator, or page you were trying to access. It might have been updated or moved in the recent UGC syllabus updates.
      </p>

      <!-- Fast Search Bar -->
      <form action="/degrees/all/" method="GET" style="max-width: 500px; margin: 0 auto 32px; display: flex; gap: 8px;">
        <input type="text" name="q" placeholder="Search 255+ UGC degree courses..." class="uniscope-input" style="flex: 1; padding: 12px 18px; border-radius: 12px; border: 1px solid var(--border-card, #cbd5e1); font-size: 14px;" required>
        <button type="submit" class="btn-calc-action" style="padding: 12px 22px; background: linear-gradient(135deg, #3b4fa8, #7c3aed); color: #fff; font-weight: 700; border-radius: 12px; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;">
          Search
        </button>
      </form>

      <!-- Suggested Quick Links -->
      <div style="border-top: 1px solid var(--border-subtle, #e2e8f0); padding-top: 28px; text-align: left;">
        <div style="font-size: 13px; font-weight: 700; color: var(--text-muted, #64748b); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; text-align: center;">
          Popular Resources on UniScope LK
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
          <a href="/degrees/all/" style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: 12px; text-decoration: none; color: var(--text-main, #0f172a); font-size: 14px; font-weight: 600; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> Browse All Degrees
          </a>
          <a href="/gpa-calculator/" style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: 12px; text-decoration: none; color: var(--text-main, #0f172a); font-size: 14px; font-weight: 600; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/></svg> GPA Calculator
          </a>
          <a href="/degrees/cutoff-tool/" style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: 12px; text-decoration: none; color: var(--text-main, #0f172a); font-size: 14px; font-weight: 600; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg> University Z-Score Explorer
          </a>
          <a href="/dashboard/compare/" style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: 12px; text-decoration: none; color: var(--text-main, #0f172a); font-size: 14px; font-weight: 600; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1"/><circle cx="8" cy="12" r="2"/></svg> Compare Degrees
          </a>
          <a href="/zscore-calculator/" style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: 12px; text-decoration: none; color: var(--text-main, #0f172a); font-size: 14px; font-weight: 600; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg> Z-Score Eligibility
          </a>
          <a href="/career-paths/" style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: 12px; text-decoration: none; color: var(--text-main, #0f172a); font-size: 14px; font-weight: 600; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/></svg> Job Fields Explorer
          </a>
        </div>
      </div>

      <div style="margin-top: 32px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <a href="/" class="login-btn" style="background: linear-gradient(135deg, #3b4fa8, #7c3aed); color: #fff; padding: 10px 24px; border-radius: 50px; font-weight: 600; font-size: 14px;">
          ← Return to Home
        </a>
        <a href="/contact-us/" class="login-btn" style="background: var(--bg-card-subtle, #f1f5f9); color: var(--text-main, #0f172a); border: 1px solid var(--border-card, #cbd5e1); padding: 10px 20px; border-radius: 50px; font-weight: 600; font-size: 14px;">
          Report a Broken Link
        </a>
      </div>

      <!-- Attribution footer note -->
      <div style="margin-top: 28px; font-size: 12px; color: var(--text-muted, #94a3b8);">
        UniScope LK · Sri Lanka's Independent Higher Education Information Platform
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
