<%- include('partials/head', { title: "University Application Checklist - UniScope LK" }) %>
<%- include('partials/navbar') %>

<style>
.chk-page {
  background: var(--bg-page);
  min-height: 100vh;
  padding: 110px 20px 80px;
  color: var(--text-main);
}

.chk-container {
  max-width: 1200px;
  margin: 0 auto;
}

/* Hero Section */
.chk-hero {
  text-align: center;
  max-width: 860px;
  margin: 0 auto 36px;
}

.chk-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--apple-blue-subtle, rgba(0, 113, 227, 0.08));
  color: var(--apple-blue, #0071e3);
  padding: 6px 18px;
  border-radius: 980px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 14px;
  border: 1px solid rgba(0, 113, 227, 0.2);
}

.chk-title {
  font-size: clamp(30px, 4.2vw, 44px);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 12px;
  color: var(--text-main);
}

.chk-subtitle {
  font-size: clamp(16px, 2vw, 19px);
  color: var(--text-muted, #64748b);
  line-height: 1.5;
  margin-bottom: 24px;
}

/* Year Selector Bar */
.chk-year-bar {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  padding: 8px 18px;
  border-radius: 980px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  margin-bottom: 30px;
}
.chk-year-bar label {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-muted);
}
.chk-year-select {
  border: none;
  background: transparent;
  font-size: 14px;
  font-weight: 700;
  color: var(--apple-blue, #0071e3);
  cursor: pointer;
  outline: none;
  font-family: inherit;
}

/* Two-column layout: Left Main Checklist, Right Summary & Resources */
.chk-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 30px;
  align-items: start;
}
@media (max-width: 992px) {
  .chk-layout {
    grid-template-columns: 1fr;
  }
}

/* Sticky Progress Card */
.chk-progress-card {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 20px;
  padding: 26px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  position: sticky;
  top: 90px;
}
[data-theme="dark"] .chk-progress-card,
body.dark .chk-progress-card {
  background: #161f36;
  border-color: #273553;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.chk-prog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.chk-prog-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text-main);
  margin: 0;
}
.chk-prog-pct {
  font-size: 26px;
  font-weight: 800;
  color: var(--apple-blue, #0071e3);
  letter-spacing: -0.02em;
}

.chk-prog-bar-wrap {
  width: 100%;
  height: 10px;
  background: var(--bg-page, #f1f5f9);
  border-radius: 980px;
  overflow: hidden;
  margin-bottom: 16px;
}
.chk-prog-bar-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #0071e3, #6366f1);
  border-radius: 980px;
  transition: width 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.chk-prog-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 20px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border-color, #e2e8f0);
}
.chk-prog-stat-box {
  background: var(--bg-page, #f8fafc);
  padding: 12px 14px;
  border-radius: 12px;
  text-align: center;
}
.chk-prog-stat-val {
  font-size: 20px;
  font-weight: 800;
  color: var(--text-main);
}
.chk-prog-stat-lbl {
  font-size: 11.5px;
  color: var(--text-muted);
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.04em;
  margin-top: 2px;
}

/* Quick Actions in sidebar */
.chk-side-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}
.chk-btn-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 11px 16px;
  border-radius: 12px;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all 180ms ease;
  border: 1px solid transparent;
  font-family: inherit;
  text-decoration: none;
}
.chk-btn-reset {
  background: rgba(239, 68, 68, 0.08);
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.2);
}
.chk-btn-reset:hover {
  background: rgba(239, 68, 68, 0.15);
}
.chk-btn-print {
  background: var(--bg-page);
  color: var(--text-main);
  border-color: var(--border-color);
}
.chk-btn-print:hover {
  border-color: var(--apple-blue);
  color: var(--apple-blue);
}

/* Official Links Sidebar Widget */
.chk-links-widget {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 16px;
  padding: 20px;
  margin-top: 20px;
}
[data-theme="dark"] .chk-links-widget,
body.dark .chk-links-widget {
  background: #161f36;
  border-color: #273553;
}
.chk-links-widget h4 {
  font-size: 14.5px;
  font-weight: 700;
  margin: 0 0 12px;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 8px;
}
.chk-link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border-radius: 10px;
  color: var(--text-main);
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  transition: background 150ms ease;
  margin-bottom: 4px;
}
.chk-link-item:hover {
  background: var(--bg-page);
  color: var(--apple-blue);
}

/* Main Section Card */
.chk-stage-card {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 20px;
  margin-bottom: 22px;
  overflow: hidden;
  box-shadow: 0 4px 18px rgba(0,0,0,0.03);
  transition: border-color 200ms ease;
}
[data-theme="dark"] .chk-stage-card,
body.dark .chk-stage-card {
  background: #161f36;
  border-color: #273553;
}

.chk-stage-header {
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border-color, #e2e8f0);
  user-select: none;
}
.chk-stage-header:hover {
  background: var(--bg-page, #f8fafc);
}
.chk-stage-left {
  display: flex;
  align-items: center;
  gap: 14px;
}
.chk-stage-badge {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: var(--apple-blue-subtle, rgba(0, 113, 227, 0.1));
  color: var(--apple-blue, #0071e3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 15px;
  flex-shrink: 0;
}
.chk-stage-title-wrap h3 {
  font-size: 17.5px;
  font-weight: 700;
  margin: 0 0 3px;
  color: var(--text-main);
}
.chk-stage-title-wrap p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
}
.chk-stage-chevron {
  width: 20px;
  height: 20px;
  color: var(--text-muted);
  transition: transform 200ms ease;
}
.chk-stage-card.collapsed .chk-stage-chevron {
  transform: rotate(-90deg);
}
.chk-stage-card.collapsed .chk-stage-body {
  display: none;
}

/* Tasks List */
.chk-tasks-list {
  padding: 8px 16px 16px;
}
.chk-task-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px 14px;
  border-radius: 14px;
  transition: background 150ms ease;
  margin-bottom: 6px;
  border-bottom: 1px solid rgba(0,0,0,0.03);
}
.chk-task-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}
.chk-task-item:hover {
  background: var(--bg-page, #f8fafc);
}
.chk-task-item.completed {
  opacity: 0.75;
}
.chk-task-item.completed .chk-task-title {
  text-decoration: line-through;
  color: var(--text-muted);
}

/* Custom Checkbox */
.chk-box-wrap {
  position: relative;
  margin-top: 3px;
}
.chk-input {
  appearance: none;
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border: 2px solid #cbd5e1;
  border-radius: 7px;
  cursor: pointer;
  background: transparent;
  display: grid;
  place-content: center;
  transition: all 180ms ease;
  outline: none;
}
.chk-input:checked {
  background: var(--apple-blue, #0071e3);
  border-color: var(--apple-blue, #0071e3);
}
.chk-input:checked::before {
  content: "";
  width: 10px;
  height: 6px;
  border-left: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  transform: rotate(-45deg) translate(1px, -1px);
}
.chk-input:focus-visible {
  box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.3);
}

.chk-task-content {
  flex: 1;
}
.chk-task-top {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}
.chk-task-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-main);
  margin: 0;
  cursor: pointer;
}
.chk-tag-crit {
  font-size: 10.5px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 6px;
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  text-transform: uppercase;
}
.chk-tag-tip {
  font-size: 10.5px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 6px;
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
  text-transform: uppercase;
}
.chk-tag-apt {
  font-size: 10.5px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 6px;
  background: rgba(139, 92, 246, 0.1);
  color: #8b5cf6;
  text-transform: uppercase;
}
.chk-task-desc {
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--text-muted, #64748b);
  margin: 0 0 8px;
}
.chk-task-ref {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  color: var(--apple-blue, #0071e3);
  text-decoration: none;
  font-weight: 600;
}
.chk-task-ref:hover {
  text-decoration: underline;
}

/* Privacy & Disclaimer Notice */
.chk-notice-box {
  background: var(--card-bg, #ffffff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 16px;
  padding: 20px 24px;
  margin-top: 30px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
}
[data-theme="dark"] .chk-notice-box,
body.dark .chk-notice-box {
  background: #161f36;
  border-color: #273553;
}
.chk-notice-icon {
  width: 24px;
  height: 24px;
  color: var(--apple-blue, #0071e3);
  flex-shrink: 0;
  margin-top: 2px;
}
.chk-notice-text {
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-muted);
}
.chk-notice-text strong {
  color: var(--text-main);
}

/* Modal confirmation */
.chk-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(4px);
  z-index: 9999;
  place-content: center;
  padding: 20px;
}
.chk-modal.active {
  display: grid;
}
.chk-modal-card {
  background: var(--card-bg, #ffffff);
  border-radius: 20px;
  padding: 28px;
  max-width: 440px;
  width: 100%;
  box-shadow: 0 20px 50px rgba(0,0,0,0.2);
  text-align: center;
}
[data-theme="dark"] .chk-modal-card,
body.dark .chk-modal-card {
  background: #1a2542;
}

/* Filter Pills */
.chk-filter-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  overflow-x: auto;
  padding-bottom: 4px;
}
.chk-filter-pill {
  padding: 8px 16px;
  border-radius: 980px;
  font-size: 13px;
  font-weight: 600;
  border: 1px solid var(--border-color, #e2e8f0);
  background: var(--card-bg, #ffffff);
  color: var(--text-muted);
  cursor: pointer;
  transition: all 150ms ease;
}
.chk-filter-pill.active {
  background: var(--apple-blue, #0071e3);
  color: #ffffff;
  border-color: var(--apple-blue);
}

/* Print styles */
@media print {
  .navbar, .footer, .chk-side-actions, .chk-filter-bar, .chk-year-bar, .chk-notice-box {
    display: none !important;
  }
  .chk-page {
    padding: 0 !important;
    background: #fff !important;
    color: #000 !important;
  }
  .chk-layout {
    grid-template-columns: 1fr !important;
  }
  .chk-stage-card.collapsed .chk-stage-body {
    display: block !important;
  }
}
</style>

<div class="chk-page">
  <div class="chk-container">

    <!-- Hero Section -->
    <div class="chk-hero">
      <div class="chk-eyebrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16">
          <polyline points="9 11 12 14 22 4"></polyline>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
        Student Admissions Tool
      </div>
      <h1 class="chk-title">University Application Checklist</h1>
      <div class="chk-subtitle">
        Your interactive step-by-step roadmap to prepare, apply, and register for Sri Lankan state university admissions via UGC.
      </div>

      <!-- Academic Year Selection -->
      <div class="chk-year-bar">
        <label for="academicYearSelect">Admission Cycle:</label>
        <select id="academicYearSelect" class="chk-year-select" onchange="onYearChange()">
          <option value="2024_2025" selected>Academic Year 2024/2025 (Current Intake)</option>
          <option value="2023_2024">Academic Year 2023/2024 (Previous Intake)</option>
          <option value="2025_2026">Academic Year 2025/2026 (Upcoming A/L)</option>
        </select>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="chk-filter-bar">
      <button class="chk-filter-pill active" onclick="setFilter('all', this)">All Tasks (<span id="countAll">20</span>)</button>
      <button class="chk-filter-pill" onclick="setFilter('pending', this)">Pending (<span id="countPending">20</span>)</button>
      <button class="chk-filter-pill" onclick="setFilter('completed', this)">Completed (<span id="countCompleted">0</span>)</button>
      <button class="chk-filter-pill" onclick="toggleExpandAll(this)" style="margin-left:auto;">Collapse All</button>
    </div>

    <div class="chk-layout">
      <!-- Left: Checklist Stages -->
      <div class="chk-main">

        <!-- Stage 1 -->
        <div class="chk-stage-card" id="stage1">
          <div class="chk-stage-header" onclick="toggleStage('stage1')">
            <div class="chk-stage-left">
              <div class="chk-stage-badge">01</div>
              <div class="chk-stage-title-wrap">
                <h3>Before Applying — Research &amp; Eligibility</h3>
                <p>Foundational preparations before the UGC online admissions window opens.</p>
              </div>
            </div>
            <svg class="chk-stage-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <div class="chk-stage-body">
            <div class="chk-tasks-list">

              <div class="chk-task-item" data-task-id="t1_handbook">
                <div class="chk-box-wrap">
                  <input type="checkbox" id="t1_handbook" class="chk-input" onchange="toggleTask('t1_handbook')">
                </div>
                <div class="chk-task-content">
                  <div class="chk-task-top">
                    <label for="t1_handbook" class="chk-task-title">Read the Official UGC Admission Handbook</label>
                    <span class="chk-tag-crit">Essential</span>
                  </div>
                  <p class="chk-task-desc">Obtain and carefully read the UGC Admission Handbook for the applicable academic year. Confirm university rules, district quota policies (40% Merit, 55% District, 5% Underprivileged), and faculty admission codes.</p>
                  <a href="https://eugc.ugc.ac.lk/ugc_handbook/" target="_blank" rel="noopener noreferrer" class="chk-task-ref">
                    View Official UGC Handbook Online ↗
                  </a>
                </div>
              </div>

              <div class="chk-task-item" data-task-id="t1_eligibility">
                <div class="chk-box-wrap">
                  <input type="checkbox" id="t1_eligibility" class="chk-input" onchange="toggleTask('t1_eligibility')">
                </div>
                <div class="chk-task-content">
                  <div class="chk-task-top">
                    <label for="t1_eligibility" class="chk-task-title">Verify Minimum University Admission Eligibility</label>
                    <span class="chk-tag-crit">Essential</span>
                  </div>
                  <p class="chk-task-desc">Confirm you obtained at least 3 'S' passes in approved G.C.E. Advanced Level subjects in a single sitting, and that your Common General Test mark satisfies the UGC minimum benchmark.</p>
                </div>
              </div>

              <div class="chk-task-item" data-task-id="t1_prereqs">
                <div class="chk-box-wrap">
                  <input type="checkbox" id="t1_prereqs" class="chk-input" onchange="toggleTask('t1_prereqs')">
                </div>
                <div class="chk-task-content">
                  <div class="chk-task-top">
                    <label for="t1_prereqs" class="chk-task-title">Check Subject Grade &amp; O/L Prerequisite Requirements</label>
                    <span class="chk-tag-tip">Guideline</span>
                  </div>
                  <p class="chk-task-desc">Certain faculties require specific grade thresholds (e.g. minimum 'C' in English at O/L, or specific science combination). Check section 3 of the UGC Handbook for your target courses.</p>
                </div>
              </div>

              <div class="chk-task-item" data-task-id="t1_aptitude">
                <div class="chk-box-wrap">
                  <input type="checkbox" id="t1_aptitude" class="chk-input" onchange="toggleTask('t1_aptitude')">
                </div>
                <div class="chk-task-content">
                  <div class="chk-task-top">
                    <label for="t1_aptitude" class="chk-task-title">Check Aptitude Test Requirements &amp; Deadlines</label>
                    <span class="chk-tag-apt">Aptitude</span>
                  </div>
                  <p class="chk-task-desc">Programmes such as Architecture, Design, Fashion, Information Systems (UCSC/Moratuwa), Sports Science, and Translation require university aptitude tests. Notice periods and test applications are published separately by each university.</p>
                  <a href="https://www.ugc.ac.lk/" target="_blank" rel="noopener noreferrer" class="chk-task-ref">
                    Monitor UGC Aptitude Notices ↗
                  </a>
                </div>
              </div>

              <div class="chk-task-item" data-task-id="t1_preferencelist">
                <div class="chk-box-wrap">
                  <input type="checkbox" id="t1_preferencelist" class="chk-input" onchange="toggleTask('t1_preferencelist')">
                </div>
                <div class="chk-task-content">
                  <div class="chk-task-top">
                    <label for="t1_preferencelist" class="chk-task-title">Draft Your Degree Preference Order</label>
                    <span class="chk-tag-crit">High Priority</span>
                  </div>
                  <p class="chk-task-desc">Prepare a comprehensive list of preferred university courses. UGC algorithm considers your choices in strict hierarchical order: if you qualify for preference #2, all lower preferences (#3, #4, ...) are forfeited. Use UniScope Degree Explorer to compare cut-offs.</p>
                  <a href="/degrees/cutoff-tool/" class="chk-task-ref">
                    Explore Past Z-Score Cut-Offs on UniScope ↗
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Stage 2 -->
        <div class="chk-stage-card" id="stage2">
          <div class="chk-stage-header" onclick="toggleStage('stage2')">
            <div class="chk-stage-left">
              <div class="chk-stage-badge">02</div>
              <div class="chk-stage-title-wrap">
                <h3>Prepare Credentials &amp; Documents</h3>
                <p>Gather official identity details, contacts, and certificates.</p>
              </div>
            </div>
            <svg class="chk-stage-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <div class="chk-stage-body">
            <div class="chk-tasks-list">

              <div class="chk-task-item" data-task-id="t2_nic">
                <div class="chk-box-wrap">
                  <input type="checkbox" id="t2_nic" class="chk-input" onchange="toggleTask('t2_nic')">
                </div>
                <div class="chk-task-content">
                  <div class="chk-task-top">
                    <label for="t2_nic" class="chk-task-title">Ensure Valid NIC Details &amp; Date of Birth Consistency</label>
                    <span class="chk-tag-crit">Identity</span>
                  </div>
                  <p class="chk-task-desc">Verify your National Identity Card (NIC) number and full name match your G.C.E. A/L examination records and Birth Certificate exactly. Rectify any discrepancies with DRP beforehand.</p>
                </div>
              </div>

              <div class="chk-task-item" data-task-id="t2_email_phone">
                <div class="chk-box-wrap">
