<%- include('partials/scripts') %>

<script>
const TOTAL_TASKS = 20;
let currentYear = '2024_2025';
let currentFilter = 'all';

function getStorageKey() {
  return `uniscope_app_checklist_${currentYear}`;
}

function loadProgress() {
  try {
    const raw = localStorage.getItem(getStorageKey());
    const saved = raw ? JSON.parse(raw) : {};
    let completedCount = 0;

    document.querySelectorAll('.chk-task-item').forEach(item => {
      const id = item.getAttribute('data-task-id');
      const input = document.getElementById(id);
      if (input) {
        const isDone = !!saved[id];
        input.checked = isDone;
        if (isDone) {
          item.classList.add('completed');
          completedCount++;
        } else {
          item.classList.remove('completed');
        }
      }
    });

    updateStats(completedCount);
    applyFilter();
  } catch (err) {
    console.error('Failed to load checklist progress:', err);
  }
}

function saveProgress() {
  try {
    const state = {};
    document.querySelectorAll('.chk-task-item').forEach(item => {
      const id = item.getAttribute('data-task-id');
      const input = document.getElementById(id);
      if (input && input.checked) {
        state[id] = true;
      }
    });
    localStorage.setItem(getStorageKey(), JSON.stringify(state));
  } catch (err) {
    console.error('Failed to save checklist progress:', err);
  }
}

function toggleTask(id) {
  const input = document.getElementById(id);
  const item = document.querySelector(`.chk-task-item[data-task-id="${id}"]`);
  if (!input || !item) return;

  if (input.checked) {
    item.classList.add('completed');
  } else {
    item.classList.remove('completed');
  }

  saveProgress();

  let completedCount = document.querySelectorAll('.chk-input:checked').length;
  updateStats(completedCount);
  applyFilter();
}

function updateStats(completedCount) {
  const pct = Math.round((completedCount / TOTAL_TASKS) * 100);
  const remaining = TOTAL_TASKS - completedCount;

  document.getElementById('progressPct').textContent = `${pct}%`;
  document.getElementById('progressBar').style.width = `${pct}%`;
  document.getElementById('statCompleted').textContent = completedCount;
  document.getElementById('statRemaining').textContent = remaining;

  document.getElementById('countAll').textContent = TOTAL_TASKS;
  document.getElementById('countPending').textContent = remaining;
  document.getElementById('countCompleted').textContent = completedCount;
}

function toggleStage(stageId) {
  const stage = document.getElementById(stageId);
  if (stage) {
    stage.classList.toggle('collapsed');
  }
}

function toggleExpandAll(btn) {
  const cards = document.querySelectorAll('.chk-stage-card');
  const isAnyCollapsed = Array.from(cards).some(c => c.classList.contains('collapsed'));

  cards.forEach(c => {
    if (isAnyCollapsed) {
      c.classList.remove('collapsed');
    } else {
      c.classList.add('collapsed');
    }
  });

  btn.textContent = isAnyCollapsed ? 'Collapse All' : 'Expand All';
}

function setFilter(filterType, btn) {
  currentFilter = filterType;
  document.querySelectorAll('.chk-filter-pill').forEach(b => {
    if (b !== btn && (b.textContent.includes('All') || b.textContent.includes('Pending') || b.textContent.includes('Completed'))) {
      b.classList.remove('active');
    }
  });
  if (btn) btn.classList.add('active');
  applyFilter();
}

function applyFilter() {
  document.querySelectorAll('.chk-task-item').forEach(item => {
    const isCompleted = item.classList.contains('completed');
    if (currentFilter === 'all') {
      item.style.display = 'flex';
    } else if (currentFilter === 'pending') {
      item.style.display = isCompleted ? 'none' : 'flex';
    } else if (currentFilter === 'completed') {
      item.style.display = isCompleted ? 'flex' : 'none';
    }
  });
}

function onYearChange() {
  const select = document.getElementById('academicYearSelect');
  currentYear = select.value;
  loadProgress();
}

function openResetModal() {
  document.getElementById('resetModal').classList.add('active');
}

function closeResetModal() {
  document.getElementById('resetModal').classList.remove('active');
}

function confirmReset() {
  try {
    localStorage.removeItem(getStorageKey());
  } catch (e) {}
  closeResetModal();
  loadProgress();
}

// Initial load
document.addEventListener('DOMContentLoaded', () => {
  loadProgress();
});
</script>
