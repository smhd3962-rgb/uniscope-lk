<%- include('partials/head', { title: "Smart Degree Comparison - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding: 100px 20px 80px; color: var(--text-main);">
  <div class="container" style="max-width: 1250px;">
    
    <div style="text-align:center; margin-bottom: 36px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:var(--bg-card); border:1px solid var(--border-subtle); padding:4px 14px; border-radius:980px; font-size:12px; font-weight:700; color:var(--apple-blue); letter-spacing:0.04em; text-transform:uppercase; margin-bottom:14px; box-shadow:var(--shadow-sm);">
        Side-by-Side Analysis
      </div>
      <h1 style="font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif; font-size: clamp(30px, 4.5vw, 42px); font-weight: 700; letter-spacing: -0.03em; color:var(--text-main); margin-bottom: 10px;">
        Smart Degree Comparison
      </h1>
      <p style="color:var(--text-secondary); font-size: 16.5px; max-width: 680px; margin: 0 auto; line-height: 1.5;">
        17-Section side-by-side like-for-like comparison — evaluate degrees without bias or cherry-picking
      </p>
    </div>

    <!-- Degree Selection Bar (Apple Card) -->
    <div class="uniscope-card" style="padding: 24px 28px; margin-bottom: 30px; border-radius: 20px;">
      <form method="GET" action="/dashboard/compare/" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end;">
        
        <div style="flex:1; min-width:220px;">
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:8px;">Degree 1</label>
          <select name="d1" class="uniscope-select" required>
            <option value="">Select First Degree</option>
            <% allDegrees.forEach(function(d) { %>
              <option value="<%= d.code %>" <%= (selectedCodes[0] === d.code) ? 'selected' : '' %>><%= d.name %> (<%= d.university %>)</option>
            <% }); %>
          </select>
        </div>

        <div style="flex:1; min-width:220px;">
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:8px;">Degree 2</label>
          <select name="d2" class="uniscope-select" required>
            <option value="">Select Second Degree</option>
            <% allDegrees.forEach(function(d) { %>
              <option value="<%= d.code %>" <%= (selectedCodes[1] === d.code) ? 'selected' : '' %>><%= d.name %> (<%= d.university %>)</option>
            <% }); %>
          </select>
        </div>

        <div style="flex:1; min-width:220px;">
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:8px;">Degree 3 (Optional)</label>
          <select name="d3" class="uniscope-select">
            <option value="">Select Third Degree</option>
            <% allDegrees.forEach(function(d) { %>
              <option value="<%= d.code %>" <%= (selectedCodes[2] === d.code) ? 'selected' : '' %>><%= d.name %> (<%= d.university %>)</option>
            <% }); %>
          </select>
        </div>

        <div style="flex:1; min-width:180px;">
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:8px;">District for Cut-Offs</label>
          <select name="district" class="uniscope-select">
            <% (districts || []).forEach(function(dist) { %>
              <option value="<%= dist %>" <%= (selectedDistrict === dist) ? 'selected' : '' %>><%= dist %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <button type="submit" class="btn-calc-action" style="height: 42px;">
            Compare Now
          </button>
        </div>
      </form>
    </div>

    <!-- Comparison Matrix Table -->
    <% if (comparedDegrees && comparedDegrees.length > 0) { %>
      <div class="uniscope-table-wrap">
        <table class="uniscope-table table-sticky-col" style="min-width: 850px;">
          <thead>
            <tr>
              <th style="width: 240px; font-size: 13.5px;">
                Comparison Facet (17-Sections)
              </th>
              <% comparedDegrees.forEach(function(deg) { %>
                <th style="min-width: 260px;">
                  <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                    <img src="<%= getUniLogo(deg.university) %>"
                         alt="<%= deg.university %> Logo"
                         loading="lazy"
                         onerror="this.onerror=null; this.src='/assets/placeholders/university_logo_placeholder.svg';"
                         style="width:32px; height:32px; object-fit:contain; border-radius:8px; background:#ffffff; padding:3px; border:1px solid var(--border-subtle); box-shadow:var(--shadow-sm);">
                    <div style="font-size:11.5px; color:var(--apple-blue); text-transform:uppercase; font-weight: 700; letter-spacing:0.04em;">CODE: <%= deg.code %></div>
                  </div>
                  <div style="font-size:16px; font-weight:700; letter-spacing:-0.015em; color:var(--text-main); line-height:1.35;"><%= deg.name %></div>
                  <div style="font-size:12.5px; color:var(--text-secondary); font-weight:500; margin-top:4px;"><%= deg.university %></div>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <!-- 1. Faculty & Campus -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">1. Faculty &amp; Campus</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td style="font-weight:600;"><%= d.faculty %></td>
              <% }); %>
            </tr>

            <!-- 2. Stream Eligibility -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">2. A/L Stream</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <span style="background:rgba(124,58,237,0.12); color:#7c3aed; padding:4px 10px; border-radius:6px; font-weight:700; font-size:12px; border:1px solid rgba(124,58,237,0.2);"><%= d.stream %></span>
                </td>
              <% }); %>
            </tr>

            <!-- 3. Duration & SLQF Level -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">3. Duration &amp; SLQF</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td style="font-weight:600;"><%= d.duration_years %> Years (SLQF Level <%= d.slqf_level %>)</td>
              <% }); %>
            </tr>

            <!-- 4. Medium of Instruction -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">4. Medium of Instruction</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td style="font-weight:600;"><%= d.medium %></td>
              <% }); %>
            </tr>

            <!-- 5. Average Z-Score Threshold -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">5. Avg Cutoff Z-Score</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <span style="font-weight:800; color:var(--text-main); font-size:15px;"><%= d.min_zscore_avg %></span>
                  <span style="font-size:11.5px; color:var(--text-muted); margin-left:4px;">(UGC 3-Yr Avg)</span>
                </td>
              <% }); %>
            </tr>

            <!-- 6. AI Displacement Risk -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">6. AI Displacement Risk</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <span style="font-weight:800; color:<%= d.risk <= 25 ? '#10b981' : (d.risk <= 50 ? '#f59e0b' : '#ef4444') %>;">
                    <%= d.risk %>% · <%= d.risk_band %> Risk
                  </span>
                </td>
              <% }); %>
            </tr>

            <!-- 7. Specialization Tracks -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">7. Specializations</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <div style="display:flex; flex-direction:column; gap:4px;">
                    <% (d.specializations || []).forEach(function(sp) { %>
                      <span style="font-size:12.5px; color:var(--text-secondary);">• <%= sp %></span>
                    <% }); %>
                  </div>
                </td>
              <% }); %>
            </tr>

            <!-- 8. Public Sector Government Careers -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">8. Public Sector Roles</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <div style="display:flex; flex-direction:column; gap:4px;">
                    <% (d.careers_public || []).forEach(function(cp) { %>
                      <span style="font-size:12.5px; color:#10b981; font-weight:600;">✓ <%= cp %></span>
                    <% }); %>
                  </div>
                </td>
              <% }); %>
            </tr>

            <!-- 9. Private Corporate Careers -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">9. Private Corporate Roles</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <div style="display:flex; flex-direction:column; gap:4px;">
                    <% (d.careers_private || []).forEach(function(cp) { %>
                      <span style="font-size:12.5px; color:#7c3aed; font-weight:600;">✓ <%= cp %></span>
                    <% }); %>
                  </div>
                </td>
              <% }); %>
            </tr>

            <!-- 10. Practical / Lab Exposure -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">10. Practical Exposure</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td style="font-weight:700; color:var(--text-main);">
                  <%= (d.vector && d.vector[2]) || 8 %> / 10 Index
                </td>
              <% }); %>
            </tr>

            <!-- 11. Academic Rigor -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">11. Academic Rigor</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td style="font-weight:700; color:var(--text-main);">
                  <%= (d.vector && d.vector[3]) || 9 %> / 10 Index
                </td>
              <% }); %>
            </tr>

            <!-- 12. Human Empathy Shield -->
            <tr>
              <td style="font-weight:700; color:var(--text-secondary);">12. Empathy Protection</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td style="font-weight:700; color:#10b981;">
                  <%= d.h_human %> points
                </td>
              <% }); %>
            </tr>

            <!-- Action Link Row -->
            <tr style="background:var(--bg-card-subtle);">
              <td style="font-weight:700; color:var(--text-secondary);">Actions</td>
              <% comparedDegrees.forEach(function(d) { %>
                <td>
                  <a href="/degrees/detail/<%= encodeURIComponent(d.code) %>/" style="display:inline-block; padding:8px 16px; background:linear-gradient(135deg, #3b4fa8, #7c3aed); color:#fff; border-radius:8px; text-decoration:none; font-weight:700; font-size:12.5px;">
                    Full 17-Section Profile →
                  </a>
                </td>
              <% }); %>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Historical UGC Cut-Off Trend Analysis -->
      <% if (historicalData && historicalData.length > 0) { %>
        <div class="uniscope-card" style="margin-top:36px; padding:28px; border-radius:20px;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:20px;">
            <div>
              <div style="font-size:12px; font-weight:700; color:var(--apple-blue); letter-spacing:0.04em; text-transform:uppercase; margin-bottom:4px;">
                Multi-Year Trend Analysis
              </div>
              <h3 style="font-size:20px; font-weight:700; color:var(--text-main); margin:0;">
                Historical UGC Cut-Off Comparison (<%= selectedDistrict %> District)
              </h3>
            </div>
            <span style="font-size:12.5px; color:var(--text-secondary); background:var(--bg-card-subtle); border:1px solid var(--border-subtle); padding:5px 12px; border-radius:980px;">
              Target District: <strong><%= selectedDistrict %></strong>
            </span>
          </div>

          <div style="overflow-x:auto;">
            <table class="uniscope-table" style="min-width:700px;">
              <thead>
                <tr>
                  <th>Degree Programme</th>
                  <th>2022/2023</th>
                  <th>2023/2024</th>
                  <th>2024/2025</th>
                  <th>2025/2026 (Latest)</th>
                  <th>YoY Change</th>
                  <th>Historical Average</th>
                </tr>
              </thead>
              <tbody>
                <% historicalData.forEach(function(row) { %>
                  <tr>
                    <td style="font-weight:700; color:var(--text-main);">
                      <div><%= row.degreeName %></div>
                      <div style="font-size:12px; color:var(--text-secondary); font-weight:500;"><%= row.university %> (<%= row.degreeCode %>)</div>
                    </td>
                    <td style="font-variant-numeric:tabular-nums;"><%= typeof row.records['2022/2023'] === 'number' ? row.records['2022/2023'].toFixed(4) : row.records['2022/2023'] %></td>
                    <td style="font-variant-numeric:tabular-nums;"><%= typeof row.records['2023/2024'] === 'number' ? row.records['2023/2024'].toFixed(4) : row.records['2023/2024'] %></td>
                    <td style="font-variant-numeric:tabular-nums;"><%= typeof row.records['2024/2025'] === 'number' ? row.records['2024/2025'].toFixed(4) : row.records['2024/2025'] %></td>
                    <td style="font-variant-numeric:tabular-nums; font-weight:700; color:var(--apple-blue); font-size:14.5px;">
                      <%= typeof row.records['2025/2026'] === 'number' ? row.records['2025/2026'].toFixed(4) : row.records['2025/2026'] %>
                    </td>
                    <td>
                      <span style="font-size:12.5px; font-weight:700; color:<%= row.yoyChange.startsWith('+') ? '#ef4444' : (row.yoyChange.startsWith('-') ? '#10b981' : 'var(--text-muted)') %>;">
                        <%= row.yoyChange %>
                      </span>
                    </td>
                    <td style="font-variant-numeric:tabular-nums; font-weight:600;"><%= row.average %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div style="margin-top:18px; padding:12px 16px; border-radius:10px; background:var(--bg-card-subtle); border:1px solid var(--border-subtle); font-size:12.5px; color:var(--text-secondary); line-height:1.5;">
            <strong>Advisory:</strong> Historical cut-offs show how minimum selection scores changed in previous academic years. They do not predict or guarantee admission for upcoming cohorts.
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="uniscope-card" style="text-align:center; padding:60px 20px; border-radius:20px;">
        <div style="width:64px; height:64px; border-radius:50%; background:var(--apple-blue-subtle); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
            <path d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1"/>
            <path d="M18 8h4a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-4"/>
            <circle cx="8" cy="12" r="2"/>
          </svg>
        </div>
        <h3 style="font-size:20px; font-weight:700; color:var(--text-main); margin-bottom:8px;">Select At Least 2 Degrees Above</h3>
        <p style="color:var(--text-secondary); font-size:14.5px; max-width:480px; margin:0 auto;">Choose degrees from the dropdowns above to generate a side-by-side like-for-like comparison.</p>
      </div>
    <% } %>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
