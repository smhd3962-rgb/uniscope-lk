<%- include('partials/head', { title: "UniScope LK - Sri Lanka Higher Education Directory & UGC Admissions Platform" }) %>
<%- include('partials/navbar') %>

<!-- Sri Lankan State University Campus Collage Continuous Flow Backdrop -->
<div class="homepage-campus-backdrop" aria-hidden="true">
  <div class="backdrop-img"></div>
  <div class="backdrop-overlay"></div>
</div>

<main class="homepage-root">
<!-- Apple-Inspired Minimalist Grand Hero -->
<section class="hero apple-reveal">
  <div class="hero-content">
    <div class="hero-text">
      <div style="display:flex; justify-content:center; align-items:center; margin-bottom:16px;">
        <img src="/static/home/images/uniscope_logo_mark.png" alt="UniScope LK Official Emblem" style="height:52px; width:auto; object-fit:contain; filter:drop-shadow(0 6px 16px rgba(0,113,227,0.18));">
      </div>
      <div class="hero-eyebrow">
        <span class="dot"></span>
        Official UGC Admissions &amp; Higher Education Intelligence · 2025/2026 Active
      </div>
      <h1 class="hero-title">
        Explore Your Future.
      </h1>
      <p class="hero-subtitle">
        Discover degree programmes, compare university options, explore official admission information, and plan your academic journey with UniScope LK.
      </p>
      <p class="hero-description">
        A trusted, independent higher education platform designed for G.C.E. A/L candidates, 
        university undergraduates, and academic advisers to evaluate official UGC cut-off marks, calculate university GPA, 
        and map verified career pathways across Sri Lanka.
      </p>

      <!-- Apple Spotlight Search Experience -->
      <div class="hero-search-wrap" style="max-width:560px; margin:0 auto 36px;">
        <form action="/degrees/all/" method="GET" class="hero-search-form" style="display:flex; align-items:center; background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--radius-pill); padding:6px 8px 6px 18px; box-shadow:var(--shadow-md); transition:box-shadow 0.2s, border-color 0.2s;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" style="color:var(--text-muted); margin-right:10px; flex-shrink:0;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" name="q" placeholder="Search 255+ degrees, subjects, or universities..." aria-label="Search degrees" style="flex:1; border:none; outline:none; background:transparent; font-size:15px; color:var(--text-main); font-family:inherit;">
          <button type="submit" class="btn-primary" style="padding:10px 22px; font-size:14px;">Search</button>
        </form>
      </div>

      <div class="hero-buttons">
        <a href="/subject-combination/" class="btn-primary" data-testid="button-hero-explore">
          Explore Degrees by Subjects
        </a>
        <a href="/degrees/cutoff-tool/" class="btn-hero-outline" data-testid="button-hero-compare">
          University Z-Score Explorer
        </a>
        <a href="/degree-finder/" class="btn-hero-outline" data-testid="button-hero-finder">
          Smart Degree Finder (AI)
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Student Pathways Bento Cards (Apple-Style 3-Column Wayfinding) -->
<section style="padding: 20px 0 60px; background: transparent;">
  <div class="container">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(270px, 1fr)); gap:20px;">
      <!-- Pathway 1: For A/L Students -->
      <div class="uniscope-card" style="padding:32px 28px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <span style="font-size:11px; font-weight:700; color:var(--apple-blue); letter-spacing:0.06em; text-transform:uppercase;">For A/L Students</span>
          <h3 style="font-size:22px; font-weight:700; letter-spacing:-0.02em; margin:8px 0 10px; color:var(--text-main);">Subject to Degree Path</h3>
          <p style="font-size:14.5px; color:var(--text-secondary); line-height:1.55; margin-bottom:20px;">
            Select your 3 A/L subjects to instantly discover all eligible state university degrees, district cut-off predictions, and special intake requirements.
          </p>
        </div>
        <a href="/subject-combination/" class="apple-link" style="color:var(--apple-blue); font-weight:600; text-decoration:none; font-size:14.5px; display:inline-flex; align-items:center; gap:5px;">
          Match Your Subjects <span>→</span>
        </a>
      </div>

      <!-- Pathway 2: For Undergraduates -->
      <div class="uniscope-card" style="padding:32px 28px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between; border-color:rgba(0,113,227,0.25);">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11px; font-weight:700; color:var(--apple-blue); letter-spacing:0.06em; text-transform:uppercase;">For Undergraduates</span>
            <span style="background:var(--apple-blue); color:#fff; font-size:9.5px; padding:2px 7px; border-radius:980px; font-weight:700;">NEW</span>
          </div>
          <h3 style="font-size:22px; font-weight:700; letter-spacing:-0.02em; margin:8px 0 10px; color:var(--text-main);">Official GPA Calculator</h3>
          <p style="font-size:14.5px; color:var(--text-secondary); line-height:1.55; margin-bottom:20px;">
            Calculate SGPA and cumulative CGPA across 8 semesters with official UoM 4.2 and UGC 4.0 scales, repeat caps, and Honours Class prediction.
          </p>
        </div>
        <a href="/gpa-calculator/" class="apple-link" style="color:var(--apple-blue); font-weight:600; text-decoration:none; font-size:14.5px; display:inline-flex; align-items:center; gap:5px;">
          Calculate Your GPA <span>→</span>
        </a>
      </div>

      <!-- Pathway 3: For Career Planners -->
      <div class="uniscope-card" style="padding:32px 28px; border-radius:var(--radius-xl); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <span style="font-size:11px; font-weight:700; color:var(--apple-blue); letter-spacing:0.06em; text-transform:uppercase;">For Career Planners</span>
          <h3 style="font-size:22px; font-weight:700; letter-spacing:-0.02em; margin:8px 0 10px; color:var(--text-main);">AI Risk &amp; Job Fields</h3>
          <p style="font-size:14.5px; color:var(--text-secondary); line-height:1.55; margin-bottom:20px;">
            Evaluate future displacement risks for 170+ professions calibrated with Sri Lankan labor market absorption coefficients and salary benchmarks.
          </p>
        </div>
        <a href="/ai-risk/" class="apple-link" style="color:var(--apple-blue); font-weight:600; text-decoration:none; font-size:14.5px; display:inline-flex; align-items:center; gap:5px;">
          Analyze AI Risk <span>→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Stats Bar with Truthful Database Metrics -->
<div class="hs-bar-wrap">
  <div class="hs-bar">
    <div class="hs-stat">
      <span class="hs-num" data-t="255" data-s="" data-a="+">255+</span>
      <span class="hs-lbl">Degree Programmes</span>
    </div>
    <div class="hs-div"></div>
    <div class="hs-stat">
      <span class="hs-num" data-t="21" data-s="" data-a="">21</span>
      <span class="hs-lbl">Universities Covered</span>
    </div>
    <div class="hs-div"></div>
    <div class="hs-stat">
      <span class="hs-num" data-t="26" data-s="K" data-a="+">26K+</span>
      <span class="hs-lbl">Verified UGC Cut-Offs</span>
    </div>
    <div class="hs-div"></div>
    <div class="hs-stat">
      <span class="hs-num" data-t="25" data-s="" data-a="">25</span>
      <span class="hs-lbl">Districts Supported</span>
    </div>
  </div>
</div>

<!-- National Universities Showcase (Real Campus Photography & Official Emblems) -->
<section style="padding: 70px 0 30px; background: transparent;">
  <div class="container">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom: 28px; flex-wrap:wrap; gap:14px;">
      <div>
        <div style="font-size:12px; font-weight:700; color:var(--apple-blue); letter-spacing:0.04em; text-transform:uppercase; margin-bottom:6px;">
          National Higher Education
        </div>
        <h2 style="font-size:clamp(24px, 3.5vw, 32px); font-weight:700; letter-spacing:-0.025em; color:var(--text-main); margin:0;">
          Explore Sri Lanka's State Universities
        </h2>
      </div>
      <a href="/universities/" style="color:var(--apple-blue); font-weight:600; font-size:14.5px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
        View All 17+ Universities →
      </a>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:20px;">
      <% 
        var showcaseUnis = [
          { name: 'University of Colombo', code: 'UOC', city: 'Colombo 03' },
          { name: 'University of Peradeniya', code: 'UOP', city: 'Peradeniya, Kandy' },
          { name: 'University of Moratuwa', code: 'UOM', city: 'Katubedda, Moratuwa' },
          { name: 'University of Sri Jayewardenepura', code: 'USJ', city: 'Nugegoda, Colombo' },
          { name: 'University of Kelaniya', code: 'UOK', city: 'Kelaniya, Gampaha' },
          { name: 'University of Jaffna', code: 'UOJ', city: 'Thirunelvely, Jaffna' },
          { name: 'University of Ruhuna', code: 'UOR', city: 'Wellamadama, Matara' },
          { name: 'Eastern University, Sri Lanka', code: 'EUSL', city: 'Vantharumoolai' }
        ];
      %>
      <% showcaseUnis.forEach(function(u) { %>
        <a href="/degrees/all/?q=<%= encodeURIComponent(u.name) %>" class="uniscope-card" style="border-radius:18px; overflow:hidden; text-decoration:none; color:inherit; display:flex; flex-direction:column; transition:transform 0.24s cubic-bezier(0.16,1,0.3,1), box-shadow 0.24s cubic-bezier(0.16,1,0.3,1);">
          <div style="height:130px; position:relative; overflow:hidden; background:var(--bg-card-subtle);">
            <img src="<%= getUniCampus(u.name) %>"
                 alt="<%= u.name %> Campus"
                 loading="lazy"
                 onerror="this.onerror=null; this.src='/assets/placeholders/campus_placeholder.webp';"
                 style="width:100%; height:100%; object-fit:cover;">
            <div style="position:absolute; bottom:8px; left:12px; width:36px; height:36px; border-radius:10px; background:#ffffff; box-shadow:0 2px 8px rgba(0,0,0,0.18); border:1px solid rgba(0,0,0,0.06); display:flex; align-items:center; justify-content:center; padding:3px; z-index:2;">
              <img src="<%= getUniLogo(u.name) %>"
                   alt="<%= u.name %> Crest"
                   loading="lazy"
                   onerror="this.onerror=null; this.src='/assets/placeholders/university_logo_placeholder.svg';"
                   style="max-width:100%; max-height:100%; object-fit:contain;">
            </div>
            <span style="position:absolute; top:8px; right:8px; background:rgba(0,0,0,0.65); backdrop-filter:blur(6px); color:#fff; padding:3px 8px; border-radius:980px; font-size:10.5px; font-weight:700;">
              <%= u.code %>
            </span>
          </div>
          <div style="padding:14px 16px 16px; flex:1; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <div style="font-size:15px; font-weight:700; letter-spacing:-0.01em; color:var(--text-main); margin-bottom:4px; line-height:1.3;">
                <%= u.name %>
              </div>
              <div style="font-size:12px; color:var(--text-secondary);"><%= u.city %></div>
            </div>
            <div style="margin-top:12px; font-size:12px; font-weight:600; color:var(--apple-blue); display:inline-flex; align-items:center; gap:4px;">
              Explore Degrees →
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- National Higher Education & UGC Admissions Decision Framework -->
<section class="framework-section" style="padding:60px 0; background:transparent;">
  <div class="container">
    <div style="text-align:center; max-width:820px; margin:0 auto 40px;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:var(--apple-blue-subtle); color:var(--apple-blue); padding:5px 16px; border-radius:980px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:12px; border:1px solid rgba(0,113,227,0.2);">
        <img src="/static/home/images/uniscope_logo_mark.png" alt="" style="width:16px; height:16px; object-fit:contain;">
        National Admissions &amp; Degree Intelligence
      </div>
      <h2 style="font-size:clamp(28px, 4vw, 40px); font-weight:700; letter-spacing:-0.025em; line-height:1.15; color:var(--text-main); margin:0 0 14px;">
        A Complete Decision Framework for University Admissions
      </h2>
      <p style="font-size:16px; color:var(--text-secondary); line-height:1.6; margin:0;">
        From G.C.E. A/L subject combinations and official UGC minimum selection Z-scores to faculty course modules and undergraduate GPA computation — all structured into one unified higher education system.
      </p>
    </div>

    <!-- Official UGC Sri Lanka Allocation Architecture (40% / 55% / 5%) -->
    <div class="uniscope-card" style="padding:28px 32px; border-radius:20px; margin-bottom:28px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; flex-wrap:wrap; gap:12px;">
        <div style="font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--text-main); display:inline-flex; align-items:center; gap:8px;">
          <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10b981;"></span>
          Official UGC Sri Lanka Admission Policy Standard
        </div>
        <a href="/faq/" style="font-size:13px; font-weight:600; color:var(--apple-blue); text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
          How Quotas Work (Admissions FAQ) →
        </a>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:18px;">
        <div style="padding:18px 20px; border-radius:14px; background:var(--bg-card-subtle); border:1px solid var(--border-subtle);">
          <div style="font-size:26px; font-weight:800; color:var(--apple-blue); letter-spacing:-0.02em; margin-bottom:4px;">40%</div>
          <div style="font-size:14px; font-weight:700; color:var(--text-main); margin-bottom:4px;">All-Island Merit Intake</div>
          <div style="font-size:12.5px; color:var(--text-secondary); line-height:1.5;">Rank-ordered university selection based purely on composite Z-score regardless of candidate district.</div>
        </div>
        <div style="padding:18px 20px; border-radius:14px; background:var(--bg-card-subtle); border:1px solid var(--border-subtle);">
          <div style="font-size:26px; font-weight:800; color:#7c3aed; letter-spacing:-0.02em; margin-bottom:4px;">55%</div>
          <div style="font-size:14px; font-weight:700; color:var(--text-main); margin-bottom:4px;">District Population Quota</div>
          <div style="font-size:12.5px; color:var(--text-secondary); line-height:1.5;">Proportionally allocated across all 25 administrative districts based on census school population metrics.</div>
        </div>
        <div style="padding:18px 20px; border-radius:14px; background:var(--bg-card-subtle); border:1px solid var(--border-subtle);">
          <div style="font-size:26px; font-weight:800; color:#f59e0b; letter-spacing:-0.02em; margin-bottom:4px;">5%</div>
          <div style="font-size:14px; font-weight:700; color:var(--text-main); margin-bottom:4px;">Underprivileged Districts</div>
          <div style="font-size:12.5px; color:var(--text-secondary); line-height:1.5;">Reserved equitable affirmative admission quota for the 16 recognized educationally underprivileged districts.</div>
        </div>
      </div>
    </div>

    <!-- 4 Flagship Academic Intelligence Engines -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:20px; margin-bottom:28px;">
      <!-- Card 1: Degree Information Hub -->
      <a href="/degrees/all/" class="uniscope-card" style="padding:28px 24px; border-radius:18px; text-decoration:none; color:inherit; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.2s, box-shadow 0.2s;">
        <div>
          <div style="width:42px; height:42px; border-radius:10px; background:rgba(0,113,227,0.1); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <h3 style="font-size:19px; font-weight:700; color:var(--text-main); margin:0 0 8px; letter-spacing:-0.015em;">Degree Information Hub</h3>
          <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
            Explore 255+ verified degree programmes across 21 national institutions with official intake capacities, faculty details, and medium of instruction.
          </p>
        </div>
        <div style="font-size:13px; font-weight:600; color:var(--apple-blue); display:inline-flex; align-items:center; gap:4px;">
          Browse Degree Catalog →
        </div>
      </a>

      <!-- Card 2: 17-Section Degree Comparison -->
      <a href="/dashboard/compare/" class="uniscope-card" style="padding:28px 24px; border-radius:18px; text-decoration:none; color:inherit; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.2s, box-shadow 0.2s;">
        <div>
          <div style="width:42px; height:42px; border-radius:10px; background:rgba(124,58,237,0.1); color:#7c3aed; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
              <path d="M16 3h5v5M8 3H3v5M3 16v5h5M21 16v5h-5"/>
            </svg>
          </div>
          <h3 style="font-size:19px; font-weight:700; color:var(--text-main); margin:0 0 8px; letter-spacing:-0.015em;">17-Facet Degree Comparison</h3>
          <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
            Compare two degree programmes side-by-side across entry criteria, semester syllabi, job placement benchmarks, and AI future risk bands.
          </p>
        </div>
        <div style="font-size:13px; font-weight:600; color:#7c3aed; display:inline-flex; align-items:center; gap:4px;">
          Compare Degrees →
        </div>
      </a>

      <!-- Card 3: Cut-Off Marks & Historical Trends -->
      <a href="/degrees/cutoff-tool/" class="uniscope-card" style="padding:28px 24px; border-radius:18px; text-decoration:none; color:inherit; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.2s, box-shadow 0.2s;">
        <div>
          <div style="width:42px; height:42px; border-radius:10px; background:rgba(16,185,129,0.1); color:#10b981; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
          </div>
          <h3 style="font-size:19px; font-weight:700; color:var(--text-main); margin:0 0 8px; letter-spacing:-0.015em;">Cut-Off Marks Trends</h3>
          <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
            Filter 26,000+ verified UGC cut-off records across 25 districts from 2019/20 through 2024/25 with multi-cycle trend lines.
          </p>
        </div>
        <div style="font-size:13px; font-weight:600; color:#10b981; display:inline-flex; align-items:center; gap:4px;">
          Explore Z-Scores →
        </div>
      </a>

      <!-- Card 4: Undergrad GPA & Honours Calculator -->
      <a href="/gpa-calculator/" class="uniscope-card" style="padding:28px 24px; border-radius:18px; text-decoration:none; color:inherit; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.2s, box-shadow 0.2s; border:1px solid rgba(0,113,227,0.3);">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <div style="width:42px; height:42px; border-radius:10px; background:rgba(0,113,227,0.1); color:var(--apple-blue); display:flex; align-items:center; justify-content:center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <line x1="8" y1="6" x2="16" y2="6"/>
                <line x1="16" y1="14" x2="16" y2="18"/>
                <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"/>
              </svg>
            </div>
            <span style="background:var(--apple-blue); color:#fff; font-size:10px; font-weight:700; padding:2px 8px; border-radius:980px;">NEW</span>
          </div>
          <h3 style="font-size:19px; font-weight:700; color:var(--text-main); margin:0 0 8px; letter-spacing:-0.015em;">Official GPA &amp; CGPA Suite</h3>
          <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
            Calculate SGPA/CGPA with official UoM 4.2 &amp; UGC 4.0 scales, repeat caps (Max C), NGPA exclusion, and Honours Class predictor.
          </p>
        </div>
        <div style="font-size:13px; font-weight:600; color:var(--apple-blue); display:inline-flex; align-items:center; gap:4px;">
          Calculate GPA Online →
        </div>
      </a>
    </div>

    <!-- Academic Streams Quick Navigation Strip -->
    <div class="uniscope-card" style="padding:22px 26px; border-radius:16px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;">
      <div style="font-size:13px; font-weight:700; color:var(--text-main); text-transform:uppercase; letter-spacing:0.04em;">
        Browse Degrees by Stream:
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <a href="/degrees/all/?stream=Physical+Science" style="background:var(--bg-card-subtle); border:1px solid var(--border-subtle); border-radius:980px; padding:7px 16px; font-size:13px; font-weight:600; color:var(--text-main); text-decoration:none; transition:all 0.15s;">Physical Science (60+)</a>
