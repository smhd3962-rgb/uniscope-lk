  </div>

  <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:12px 16px; margin-bottom:20px; display:grid; grid-template-columns: repeat(4, 1fr); gap:12px;">
    <div><span style="font-size:11px; color:#64748b; font-weight:600; text-transform:uppercase;">Grading Scale:</span> <div id="printScale" style="font-weight:700; font-size:13px; color:#0f172a; margin-top:2px;">UGC Standard</div></div>
    <div><span style="font-size:11px; color:#64748b; font-weight:600; text-transform:uppercase;">Overall CGPA:</span> <div id="printCgpa" style="font-size:20px; font-weight:800; color:#0071e3; margin-top:2px;">0.00</div></div>
    <div><span style="font-size:11px; color:#64748b; font-weight:600; text-transform:uppercase;">Classification:</span> <div id="printClass" style="font-weight:700; font-size:13px; color:#10b981; margin-top:2px;">General</div></div>
    <div><span style="font-size:11px; color:#64748b; font-weight:600; text-transform:uppercase;">Degree Credits:</span> <div id="printCredits" style="font-weight:700; font-size:13px; color:#0f172a; margin-top:2px;">0 Earned</div></div>
  </div>

  <div id="printSemestersBody">
    <!-- Generated dynamically during print -->
  </div>

  <div style="margin-top:28px; border-top:1px dashed #cbd5e1; padding-top:10px; font-size:10.5px; color:#64748b; text-align:center;">
    This academic audit transcript was computed via UniScope LK (https://uniscope.lk) in accordance with published Sri Lankan University By-Laws.
  </div>
</div>

<script>
  // =========================================================================
  // SRI LANKAN UNIVERSITY GRADING SCALES DEFINITION
  // =========================================================================
  const GRADING_SCALES = {
    ugc_standard: {
      name: "Sri Lanka Standard UGC / SLQF (4.00 Scale)",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.5,
        "D+": 1.3, "D": 1.0, "E/F": 0.0
      }
    },
    uom: {
      name: "University of Moratuwa (UOM - 4.20 Scale)",
      max: 4.2,
      grades: {
        "A+": 4.2, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.5,
