</div>

<!-- Print Section (Clean Academic Transcript) -->
<div id="printSection" class="print-only">
  <div style="border-bottom:2px solid #0071e3; padding-bottom:14px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:flex-end;">
    <div>
      <div style="font-size:11px; font-weight:700; color:#0071e3; letter-spacing:0.04em; text-transform:uppercase; margin-bottom:4px;">
        UniScope LK Higher Education Platform
      </div>
      <h2 style="margin:0; color:#0f172a; font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif; font-size:24px; font-weight:700;">
        Academic Performance Transcript &amp; GPA Audit
      </h2>
      <p style="margin:4px 0 0; font-size:12px; color:#64748b;">
        Official Sri Lankan University Student GPA &amp; CGPA Audit Transcript · Verified Statutory By-Laws
