        "C+": 2.3, "C": 2.0, "C-": 1.5,
        "D+": 1.3, "D": 1.0, "E": 0.0
      }
    },
    uoc: {
      name: "University of Colombo / UCSC (4.00 Scale)",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.7,
        "D+": 1.3, "D": 1.0, "E": 0.0
      }
    },
    usj: {
      name: "University of Sri Jayewardenepura (USJ - 4.00 Scale)",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.7,
        "D+": 1.3, "D": 1.0, "E": 0.0
      }
    },
    uok: {
      name: "University of Kelaniya (4.00 Scale)",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.5,
        "D": 1.0, "E": 0.0
      }
    },
    ruh: {
      name: "University of Ruhuna (4.00 Scale)",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.5,
        "D": 1.0, "E": 0.0
      }
    },
    sliit: {
      name: "SLIIT (4.00 Scale)",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.7,
        "D+": 1.3, "D": 1.0, "F": 0.0
      }
    },
    custom: {
      name: "Custom University Scale",
      max: 4.0,
      grades: {
        "A+": 4.0, "A": 4.0, "A-": 3.7,
        "B+": 3.3, "B": 3.0, "B-": 2.7,
        "C+": 2.3, "C": 2.0, "C-": 1.5,
        "D": 1.0, "E/F": 0.0
      }
    }
  };

  // State
  let currentScaleKey = 'uoj';
  let semesters = [];

  // =========================================================================
  // INITIALIZATION & LIFECYCLE
  // =========================================================================
  document.addEventListener('DOMContentLoaded', () => {
    // Check saved state in localStorage
    const saved = localStorage.getItem('uniscope_gpa_state');
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.scaleKey && GRADING_SCALES[parsed.scaleKey]) {
          currentScaleKey = parsed.scaleKey;
          document.getElementById('scalePresetSelect').value = currentScaleKey;
        }
        if (parsed.semesters && Array.isArray(parsed.semesters) && parsed.semesters.length > 0) {
          semesters = parsed.semesters;
        }
      } catch (e) {
        console.error('Error parsing saved state', e);
      }
    }

    // If empty, load sample data
    if (semesters.length === 0) {
      loadSampleJaffnaData(false);
    } else {
      renderScaleLegend();
      renderAllSemesters();
      recalculateAll();
    }

    // Set print date
    const d = new Date();
    const pDate = document.getElementById('printDate');
    if (pDate) {
      pDate.textContent = d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
    }
  });

  function saveStateToLocal() {
    const state = {
      scaleKey: currentScaleKey,
      semesters: semesters
    };
    localStorage.setItem('uniscope_gpa_state', JSON.stringify(state));
  }

  function onScaleChange() {
    currentScaleKey = document.getElementById('scalePresetSelect').value;
    renderScaleLegend();
    renderAllSemesters();
    recalculateAll();
    saveStateToLocal();
  }

  function renderScaleLegend() {
    const scale = GRADING_SCALES[currentScaleKey];
    const container = document.getElementById('scaleLegend');
    let html = `<span style="font-weight:700; color:#64748b;">Active Scale (${scale.name}):</span>`;
    for (const [grade, gpv] of Object.entries(scale.grades)) {
      html += `<span style="background:rgba(124,58,237,0.06); padding:2px 8px; border-radius:6px; font-size:12px;"><strong>${grade}</strong> = ${gpv.toFixed(1)}</span>`;
    }
    container.innerHTML = html;
    document.getElementById('scaleMaxDisplay').textContent = `out of ${scale.max.toFixed(2)} Scale`;
  }

  // =========================================================================
  // SAMPLE DATA: UNIVERSITY OF JAFFNA ELECTRICAL & ELECTRONIC ENGINEERING
  // =========================================================================
  function loadSampleJaffnaData(showAlert = true) {
    currentScaleKey = 'uoj';
    document.getElementById('scalePresetSelect').value = 'uoj';

    semesters = [
      {
        id: 'sem_1',
        title: 'Year 1 - Semester 1 (General Engineering)',
        modules: [
          { code: 'GE1010', name: 'Engineering Mathematics I', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
          { code: 'GE1020', name: 'Engineering Mechanics', credits: 3, grade: 'A-', isRepeat: false, isNgpa: false },
          { code: 'GE1030', name: 'Introduction to Electrical Engineering', credits: 3, grade: 'A+', isRepeat: false, isNgpa: false },
          { code: 'GE1040', name: 'Computer Programming (C/C++)', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
          { code: 'GE1050', name: 'Engineering Drawing', credits: 2, grade: 'B+', isRepeat: false, isNgpa: false },
          { code: 'EN1010', name: 'English for Academic Communication', credits: 2, grade: 'A', isRepeat: false, isNgpa: true } // NGPA
        ]
      },
      {
        id: 'sem_2',
        title: 'Year 1 - Semester 2 (General Engineering)',
        modules: [
          { code: 'GE2010', name: 'Engineering Mathematics II', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
          { code: 'GE2020', name: 'Materials Science & Engineering', credits: 3, grade: 'B+', isRepeat: false, isNgpa: false },
          { code: 'GE2030', name: 'Basic Thermodynamics & Fluid Mechanics', credits: 3, grade: 'A-', isRepeat: false, isNgpa: false },
          { code: 'EC2010', name: 'Analog Electronics & Semiconductor Devices', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
          { code: 'GE2040', name: 'Engineering Workshop Practice', credits: 2, grade: 'A+', isRepeat: false, isNgpa: false }
        ]
      },
      {
        id: 'sem_3',
        title: 'Year 2 - Semester 1 (Electrical & Electronic Focus)',
        modules: [
          { code: 'EC3010', name: 'Signals and Systems', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
          { code: 'EC3020', name: 'Electric Circuit Analysis & Network Theory', credits: 3, grade: 'A+', isRepeat: false, isNgpa: false },
          { code: 'EC3030', name: 'Digital Logic Design & Microcontrollers', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
          { code: 'EC3040', name: 'Electromagnetic Field Theory', credits: 3, grade: 'B+', isRepeat: false, isNgpa: false },
          { code: 'MA3010', name: 'Advanced Engineering Mathematics III', credits: 3, grade: 'A-', isRepeat: false, isNgpa: false }
        ]
      }
    ];

    renderScaleLegend();
    renderAllSemesters();
    recalculateAll();
    saveStateToLocal();

    if (showAlert && typeof showCartToast === 'function') {
      showCartToast('Loaded authentic sample Engineering modules (UOJ)');
    }
  }

  function clearAllData() {
    if (confirm("Are you sure you want to clear all semesters and courses?")) {
      semesters = [];
      addNewSemester();
      saveStateToLocal();
    }
  }

  // =========================================================================
  // SEMESTER & MODULE DOM MANIPULATION
  // =========================================================================
  function addNewSemester() {
    const semIndex = semesters.length + 1;
    const year = Math.ceil(semIndex / 2);
    const semInYear = (semIndex % 2 === 1) ? 1 : 2;
    const newSem = {
      id: 'sem_' + Date.now(),
      title: `Year ${year} - Semester ${semInYear}`,
      modules: [
        { code: '', name: 'Core Course 1', credits: 3, grade: 'A', isRepeat: false, isNgpa: false },
        { code: '', name: 'Core Course 2', credits: 3, grade: 'B+', isRepeat: false, isNgpa: false },
        { code: '', name: 'Core Course 3', credits: 3, grade: 'A-', isRepeat: false, isNgpa: false }
      ]
    };
    semesters.push(newSem);
    renderAllSemesters();
    recalculateAll();
    saveStateToLocal();
  }

  function removeSemester(semId) {
    if (confirm("Remove this semester and its courses?")) {
      semesters = semesters.filter(s => s.id !== semId);
      renderAllSemesters();
      recalculateAll();
      saveStateToLocal();
    }
  }

  function addModule(semId) {
    const sem = semesters.find(s => s.id === semId);
    if (sem) {
      sem.modules.push({
        code: '',
        name: 'New Course',
        credits: 3,
        grade: 'A',
        isRepeat: false,
        isNgpa: false
      });
      renderAllSemesters();
      recalculateAll();
      saveStateToLocal();
    }
  }

  function removeModule(semId, modIndex) {
    const sem = semesters.find(s => s.id === semId);
    if (sem) {
      sem.modules.splice(modIndex, 1);
      renderAllSemesters();
      recalculateAll();
      saveStateToLocal();
    }
  }

  function onSemTitleChange(semId, val) {
    const sem = semesters.find(s => s.id === semId);
    if (sem) {
      sem.title = val;
      saveStateToLocal();
    }
  }

  function onModuleChange(semId, modIndex, field, val) {
    const sem = semesters.find(s => s.id === semId);
    if (sem && sem.modules[modIndex]) {
      if (field === 'credits') {
        sem.modules[modIndex].credits = parseFloat(val) || 0;
      } else if (field === 'isRepeat' || field === 'isNgpa') {
        sem.modules[modIndex][field] = Boolean(val);
      } else {
        sem.modules[modIndex][field] = val;
      }
      recalculateAll();
      saveStateToLocal();
    }
  }

  // =========================================================================
  // RENDERING
  // =========================================================================
  function renderAllSemesters() {
    const container = document.getElementById('semestersContainer');
    const scale = GRADING_SCALES[currentScaleKey];
    let html = '';

    semesters.forEach((sem, sIdx) => {
      let semGpaCredits = 0;
      let semPoints = 0;
      let semTotalCredits = 0;

      sem.modules.forEach(m => {
        const c = parseFloat(m.credits) || 0;
        semTotalCredits += c;
        if (!m.isNgpa) {
          let gpv = scale.grades[m.grade] !== undefined ? scale.grades[m.grade] : 0.0;
          // Sri Lankan repeat rule: cap at 'C' / GPV 2.00
          if (m.isRepeat && gpv > 2.0) {
            gpv = 2.0;
          }
          semGpaCredits += c;
          semPoints += (c * gpv);
        }
      });

      const semGpa = semGpaCredits > 0 ? (semPoints / semGpaCredits).toFixed(2) : '0.00';

      html += `
        <div class="semester-card" id="card_${sem.id}">
          <div class="semester-header">
            <div class="sem-title-box">
              <span class="sem-badge">#${sIdx + 1}</span>
              <input type="text" class="sem-title-input" value="${escapeHtml(sem.title)}" onchange="onSemTitleChange('${sem.id}', this.value)" title="Click to rename semester">
            </div>

            <div class="sem-stats">
              <div>
                <span style="color:#64748b; font-size:12px;">Credits:</span>
                <strong>${semTotalCredits}</strong>
              </div>
              <div class="sem-gpa-pill">
                SGPA: ${semGpa}
              </div>
              <button class="btn-icon-del no-print" onclick="removeSemester('${sem.id}')" title="Delete Semester">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </div>

          <div class="modules-table-wrap">
            <table class="modules-table">
              <thead>
                <tr>
                  <th style="width:110px;">Course Code</th>
                  <th>Course Title</th>
                  <th style="width:90px;">Credits</th>
                  <th style="width:110px;">Grade</th>
                  <th style="width:75px;">GPV</th>
                  <th style="width:140px;">Flags / Rules</th>
                  <th style="width:45px;" class="no-print"></th>
                </tr>
              </thead>
              <tbody>
      `;

      sem.modules.forEach((mod, mIdx) => {
        let gpv = scale.grades[mod.grade] !== undefined ? scale.grades[mod.grade] : 0.0;
        let isCapped = false;
        if (mod.isRepeat && gpv > 2.0) {
          gpv = 2.0;
          isCapped = true;
        }

        // Grade options
        let gradeOptions = '';
        for (const g of Object.keys(scale.grades)) {
          gradeOptions += `<option value="${g}" ${mod.grade === g ? 'selected' : ''}>${g}</option>`;
        }

        html += `
          <tr>
            <td>
              <input type="text" class="input-tbl" placeholder="e.g. CS101" value="${escapeHtml(mod.code || '')}" onchange="onModuleChange('${sem.id}', ${mIdx}, 'code', this.value)">
            </td>
            <td>
              <input type="text" class="input-tbl" placeholder="e.g. Data Structures" value="${escapeHtml(mod.name || '')}" onchange="onModuleChange('${sem.id}', ${mIdx}, 'name', this.value)">
            </td>
            <td>
              <select class="input-tbl" onchange="onModuleChange('${sem.id}', ${mIdx}, 'credits', this.value)">
                <option value="1" ${mod.credits == 1 ? 'selected' : ''}>1</option>
                <option value="2" ${mod.credits == 2 ? 'selected' : ''}>2</option>
                <option value="3" ${mod.credits == 3 ? 'selected' : ''}>3</option>
                <option value="4" ${mod.credits == 4 ? 'selected' : ''}>4</option>
                <option value="5" ${mod.credits == 5 ? 'selected' : ''}>5</option>
                <option value="6" ${mod.credits == 6 ? 'selected' : ''}>6</option>
                <option value="8" ${mod.credits == 8 ? 'selected' : ''}>8</option>
              </select>
            </td>
            <td>
              <select class="input-tbl" onchange="onModuleChange('${sem.id}', ${mIdx}, 'grade', this.value)">
                ${gradeOptions}
              </select>
            </td>
            <td>
              <strong style="color:${mod.isNgpa ? '#94a3b8' : '#7c3aed'}; font-size:14px;">
                ${mod.isNgpa ? 'NGPA' : gpv.toFixed(1)}
              </strong>
              ${isCapped ? '<br><span style="font-size:10px; color:#ef4444; font-weight:700;">Cap 2.0</span>' : ''}
            </td>
            <td>
              <div style="display:flex; flex-direction:column; gap:4px; font-size:12px;">
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                  <input type="checkbox" ${mod.isRepeat ? 'checked' : ''} onchange="onModuleChange('${sem.id}', ${mIdx}, 'isRepeat', this.checked)">
                  <span class="chip-tag chip-repeat" title="Sri Lankan Exam by-law: Repeat max grade is capped at 'C' / 2.0 GPV">Repeat (Cap C)</span>
                </label>
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                  <input type="checkbox" ${mod.isNgpa ? 'checked' : ''} onchange="onModuleChange('${sem.id}', ${mIdx}, 'isNgpa', this.checked)">
                  <span class="chip-tag chip-ngpa" title="Non-GPA Module: Counts towards graduation credits, zero impact on GPA">Non-GPA (NGPA)</span>
                </label>
              </div>
            </td>
            <td class="no-print">
              <button class="btn-icon-del" onclick="removeModule('${sem.id}', ${mIdx})" title="Delete Course">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </td>
          </tr>
        `;
      });

      html += `
              </tbody>
            </table>
          </div>

          <div class="tbl-footer no-print">
            <button class="btn-add-row" onclick="addModule('${sem.id}')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add Course to Semester
            </button>
            <span style="font-size:12px; color:#64748b;">
              Semester Quality Points: <strong>${semPoints.toFixed(1)}</strong>
            </span>
          </div>
        </div>
      `;
    });

    container.innerHTML = html;
  }

  // =========================================================================
  // RECALCULATION & HONOURS CLASS ENGINE
  // =========================================================================
  function recalculateAll() {
    const scale = GRADING_SCALES[currentScaleKey];
    let totalGpaCredits = 0;
    let totalDegreeCredits = 0;
    let totalQualityPoints = 0;

    semesters.forEach(sem => {
      sem.modules.forEach(m => {
        const c = parseFloat(m.credits) || 0;
        totalDegreeCredits += c;
        if (!m.isNgpa) {
          let gpv = scale.grades[m.grade] !== undefined ? scale.grades[m.grade] : 0.0;
          if (m.isRepeat && gpv > 2.0) {
            gpv = 2.0; // Repeat cap per Sri Lankan rules
          }
          totalGpaCredits += c;
          totalQualityPoints += (c * gpv);
        }
      });
    });

    const cgpa = totalGpaCredits > 0 ? (totalQualityPoints / totalGpaCredits) : 0.0;
    const cgpaFormatted = cgpa.toFixed(2);

    // Update Sticky Display
    document.getElementById('cgpaDisplay').textContent = cgpaFormatted;
    document.getElementById('totalGpaCreditsDisplay').textContent = totalGpaCredits;
    document.getElementById('totalDegreeCreditsDisplay').textContent = totalDegreeCredits;
    document.getElementById('totalPointsDisplay').textContent = totalQualityPoints.toFixed(1);
    document.getElementById('semestersCountDisplay').textContent = semesters.length;

    // Honours Classification
    const badge = document.getElementById('honoursClassBadge');
    badge.className = 'class-badge';
    let className = 'Pass / General Degree';

    if (totalGpaCredits === 0) {
      className = 'No Courses Entered';
      badge.classList.add('class-general');
    } else if (cgpa >= 3.70) {
      className = 'First Class Honours';
      badge.classList.add('class-first');
    } else if (cgpa >= 3.30) {
      className = 'Second Class (Upper Division)';
      badge.classList.add('class-second-upper');
    } else if (cgpa >= 3.00) {
      className = 'Second Class (Lower Division)';
      badge.classList.add('class-second-lower');
    } else if (cgpa >= 2.00) {
      className = 'Pass / General Degree';
      badge.classList.add('class-general');
    } else {
      className = 'Academic Warning / Probation';
      badge.classList.add('class-warning');
    }
    badge.textContent = className;

    // Recalculate Target
    calculateTargetGpa(totalGpaCredits, totalQualityPoints);

    // Update Print Preview values
    document.getElementById('printScale').textContent = scale.name;
    document.getElementById('printCgpa').textContent = `${cgpaFormatted} / ${scale.max.toFixed(2)}`;
    document.getElementById('printClass').textContent = className;
    document.getElementById('printCredits').textContent = `${totalDegreeCredits} Total (${totalGpaCredits} GPA)`;
    preparePrintTranscript(scale);
  }

  // =========================================================================
  // TARGET GPA & WHAT-IF PLANNER
  // =========================================================================
  function calculateTargetGpa(currentGpaCredits = null, currentQualityPoints = null) {
    const scale = GRADING_SCALES[currentScaleKey];
    if (currentGpaCredits === null || currentQualityPoints === null) {
      currentGpaCredits = 0;
      currentQualityPoints = 0;
      semesters.forEach(sem => {
        sem.modules.forEach(m => {
          if (!m.isNgpa) {
            let gpv = scale.grades[m.grade] !== undefined ? scale.grades[m.grade] : 0.0;
            if (m.isRepeat && gpv > 2.0) gpv = 2.0;
            const c = parseFloat(m.credits) || 0;
            currentGpaCredits += c;
            currentQualityPoints += (c * gpv);
          }
        });
      });
    }

    const targetType = document.getElementById('targetClassSelect').value;
    const customRow = document.getElementById('customTargetRow');
    let targetCgpa = 3.70;

    if (targetType === 'custom_target') {
      customRow.style.display = 'block';
      targetCgpa = parseFloat(document.getElementById('customTargetInput').value) || 3.70;
    } else {
      customRow.style.display = 'none';
      targetCgpa = parseFloat(targetType);
    }

    const remainingCredits = parseFloat(document.getElementById('remainingCreditsInput').value) || 0;
    const resultBox = document.getElementById('targetResultBox');

    if (remainingCredits <= 0) {
      resultBox.innerHTML = '<span style="color:#ef4444;">Please enter remaining credits (> 0).</span>';
      return;
    }

    const totalTargetCredits = currentGpaCredits + remainingCredits;
    const requiredTotalPoints = targetCgpa * totalTargetCredits;
    const neededPoints = requiredTotalPoints - currentQualityPoints;
    const requiredAvgGpa = neededPoints / remainingCredits;

    if (requiredAvgGpa <= 0) {
      resultBox.innerHTML = `
        <span style="color:#10b981; font-weight:700;">Target Secured</span><br>
        Your current performance already guarantees a CGPA ≥ ${targetCgpa.toFixed(2)} with minimum passing grades.
      `;
    } else if (requiredAvgGpa > scale.max) {
      resultBox.innerHTML = `
        <span style="color:#ef4444; font-weight:700;">Mathematically Out of Reach</span><br>
        You would need an average GPA of <strong>${requiredAvgGpa.toFixed(2)}</strong> across the remaining ${remainingCredits} credits, which exceeds the university's maximum scale (${scale.max.toFixed(2)}).
      `;
    } else {
      let gradeSuggestion = 'A / A+';
      if (requiredAvgGpa <= 2.3) gradeSuggestion = 'C+ or higher';
      else if (requiredAvgGpa <= 2.7) gradeSuggestion = 'B- or higher';
      else if (requiredAvgGpa <= 3.0) gradeSuggestion = 'B or higher';
      else if (requiredAvgGpa <= 3.3) gradeSuggestion = 'B+ or higher';
      else if (requiredAvgGpa <= 3.7) gradeSuggestion = 'A- or higher';

      resultBox.innerHTML = `
        To graduate with <strong>${targetCgpa.toFixed(2)}</strong>, you must maintain an average GPA of:
        <div style="font-size:22px; font-weight:800; color:#7c3aed; margin:6px 0;">${requiredAvgGpa.toFixed(2)} / ${scale.max.toFixed(2)}</div>
        <span style="font-size:12px; opacity:0.85;">Aim for <strong>${gradeSuggestion}</strong> in all upcoming modules.</span>
      `;
    }
  }

  // =========================================================================
  // PRINT & EXPORT / IMPORT JSON
  // =========================================================================
  function preparePrintTranscript(scale) {
    const body = document.getElementById('printSemestersBody');
    if (!body) return;
    let html = '';

    semesters.forEach((sem, idx) => {
      let semGpaCredits = 0;
      let semPoints = 0;
      let semTotalCredits = 0;

      sem.modules.forEach(m => {
        const c = parseFloat(m.credits) || 0;
        semTotalCredits += c;
        if (!m.isNgpa) {
          let gpv = scale.grades[m.grade] !== undefined ? scale.grades[m.grade] : 0.0;
          if (m.isRepeat && gpv > 2.0) gpv = 2.0;
          semGpaCredits += c;
          semPoints += (c * gpv);
        }
      });
      const semGpa = semGpaCredits > 0 ? (semPoints / semGpaCredits).toFixed(2) : '0.00';

      html += `
        <div class="sem-block" style="margin-bottom:18px; page-break-inside:avoid;">
          <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1.5px solid #0071e3; padding-bottom:4px; margin-bottom:8px;">
            <h4 style="margin:0; font-size:12pt; color:#0f172a; font-weight:700;">
              Semester #${idx + 1}: ${escapeHtml(sem.title)}
            </h4>
            <span style="font-size:9.5pt; font-weight:700; color:#0071e3;">
              SGPA: ${semGpa} (${semGpaCredits} GPA Credits · ${semTotalCredits} Total)
            </span>
          </div>
          <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-bottom:10px;">
            <thead>
              <tr style="background:#f1f5f9; text-align:left;">
                <th style="padding:5px 8px; border:1px solid #cbd5e1; width:80px;">Course Code</th>
                <th style="padding:5px 8px; border:1px solid #cbd5e1;">Course Title</th>
                <th style="padding:5px 8px; border:1px solid #cbd5e1; width:55px; text-align:center;">Credits</th>
                <th style="padding:5px 8px; border:1px solid #cbd5e1; width:55px; text-align:center;">Grade</th>
                <th style="padding:5px 8px; border:1px solid #cbd5e1; width:55px; text-align:center;">GPV</th>
                <th style="padding:5px 8px; border:1px solid #cbd5e1; width:110px;">Status / Remarks</th>
              </tr>
            </thead>
            <tbody>
      `;

      sem.modules.forEach(m => {
        let gpv = scale.grades[m.grade] !== undefined ? scale.grades[m.grade] : 0.0;
        let remarks = [];
        if (m.isRepeat) {
          remarks.push('Repeat (Cap 2.0)');
          if (gpv > 2.0) gpv = 2.0;
        }
        if (m.isNgpa) {
          remarks.push('Non-GPA (Audit/NC)');
        }

        html += `
          <tr>
            <td style="padding:5px 8px; border:1px solid #cbd5e1; font-weight:600; font-family:monospace;">${escapeHtml(m.code || '-')}</td>
            <td style="padding:5px 8px; border:1px solid #cbd5e1;">${escapeHtml(m.name || 'Course Title')}</td>
            <td style="padding:5px 8px; border:1px solid #cbd5e1; text-align:center;">${m.credits}</td>
            <td style="padding:5px 8px; border:1px solid #cbd5e1; text-align:center; font-weight:700;">${m.grade}</td>
            <td style="padding:5px 8px; border:1px solid #cbd5e1; text-align:center;">${m.isNgpa ? '-' : gpv.toFixed(1)}</td>
            <td style="padding:5px 8px; border:1px solid #cbd5e1; font-size:8.5pt; color:#64748b;">${remarks.join(', ') || 'Standard'}</td>
          </tr>
        `;
      });

      html += `
            </tbody>
          </table>
        </div>
      `;
    });

    body.innerHTML = html;
  }

  function triggerGpaPrint() {
    const scale = GRADING_SCALES[currentScaleKey];
    recalculateAll();
    preparePrintTranscript(scale);
    const d = new Date();
    const dateEl = document.getElementById('printDate');
    if (dateEl) {
      dateEl.textContent = d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
    }
    window.print();
  }

  window.addEventListener('beforeprint', () => {
    const scale = GRADING_SCALES[currentScaleKey];
    recalculateAll();
    preparePrintTranscript(scale);
    const d = new Date();
    const dateEl = document.getElementById('printDate');
    if (dateEl) {
      dateEl.textContent = d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
    }
  });

  function exportDataJson() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({
      scaleKey: currentScaleKey,
      semesters: semesters,
      exportDate: new Date().toISOString(),
      platform: "UniScope LK"
    }, null, 2));
    const dlAnchor = document.createElement('a');
    dlAnchor.setAttribute("href", dataStr);
    dlAnchor.setAttribute("download", `UniScope_GPA_Transcript_${Date.now()}.json`);
    document.body.appendChild(dlAnchor);
    dlAnchor.click();
    dlAnchor.remove();
  }

  function importDataJson(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(evt) {
      try {
        const parsed = JSON.parse(evt.target.result);
        if (parsed.semesters && Array.isArray(parsed.semesters)) {
          semesters = parsed.semesters;
          if (parsed.scaleKey && GRADING_SCALES[parsed.scaleKey]) {
            currentScaleKey = parsed.scaleKey;
            document.getElementById('scalePresetSelect').value = currentScaleKey;
          }
          renderScaleLegend();
          renderAllSemesters();
          recalculateAll();
          saveStateToLocal();
          alert('Academic records successfully imported!');
        } else {
          alert('Invalid transcript JSON structure.');
        }
      } catch (err) {
        alert('Failed to parse JSON file.');
      }
    };
    reader.readAsText(file);
  }

  function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/[&<>"']/g, function(m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
    });
  }
</script>

