<%- include('partials/head', { title: "Universities Directory - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding: 100px 20px 80px; color:var(--text-main);">
  <div class="container" style="max-width: 1150px;">
    
    <div style="text-align:center; margin-bottom: 40px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:var(--bg-card); border:1px solid var(--border-subtle); padding:4px 14px; border-radius:980px; font-size:12px; font-weight:700; color:var(--apple-blue); letter-spacing:0.04em; text-transform:uppercase; margin-bottom:14px; box-shadow:var(--shadow-sm);">
        National Academic Directory
      </div>
      <h1 style="font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif; font-size: clamp(30px, 4.5vw, 42px); font-weight: 700; letter-spacing: -0.03em; color:var(--text-main); margin-bottom: 10px;">
        Sri Lankan National Universities Directory
      </h1>
      <p style="color:var(--text-secondary); font-size: 16.5px; max-width: 650px; margin: 0 auto; line-height: 1.5;">
        Profiles, faculties, and verified degree offerings across all UGC-approved state universities
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(340px, 1fr)); gap:28px;">
      <% Object.keys(universities).forEach(function(uName) { %>
        <% var u = universities[uName]; %>
        <% var logoPath = getUniLogo(uName); %>
        <% var campusPath = getUniCampus(uName); %>
        <div class="uniscope-card" style="border-radius:20px; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.24s cubic-bezier(0.16,1,0.3,1), box-shadow 0.24s cubic-bezier(0.16,1,0.3,1);">
          
          <!-- Real Campus Photography Banner -->
          <div style="position:relative; height:170px; background:var(--bg-card-subtle); overflow:hidden;">
            <img src="<%= campusPath %>"
                 alt="<%= uName %> Campus Grounds"
                 loading="lazy"
                 onerror="this.onerror=null; this.src='/assets/placeholders/campus_placeholder.webp';"
                 style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s cubic-bezier(0.16,1,0.3,1);"
                 onmouseover="this.style.transform='scale(1.04)'"
                 onmouseout="this.style.transform='scale(1.0)'">
            
            <!-- Code Badge -->
            <span style="position:absolute; top:12px; right:12px; background:rgba(0,0,0,0.65); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#ffffff; padding:4px 12px; border-radius:980px; font-weight:700; font-size:11.5px; letter-spacing:0.04em;">
              <%= u.code %>
            </span>

            <!-- Official University Logo Emblem Badge -->
            <div style="position:absolute; bottom:-18px; left:22px; width:52px; height:52px; border-radius:14px; background:#ffffff; box-shadow:0 4px 14px rgba(0,0,0,0.12); border:1px solid rgba(0,0,0,0.06); display:flex; align-items:center; justify-content:center; padding:5px; z-index:3;">
              <img src="<%= logoPath %>"
                   alt="<%= uName %> Official Crest"
                   loading="lazy"
                   onerror="this.onerror=null; this.src='/assets/placeholders/university_logo_placeholder.svg';"
                   style="max-width:100%; max-height:100%; object-fit:contain;">
            </div>
          </div>

          <!-- University Information Body -->
          <div style="padding:26px 22px 18px; flex:1; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <div style="display:flex; justify-content:flex-end; align-items:center; margin-bottom:6px;">
                <span style="font-size:12px; color:var(--text-secondary); font-weight:600;">Est. <%= u.est %></span>
              </div>

              <h3 style="font-size:18px; font-weight:700; letter-spacing:-0.02em; color:var(--text-main); margin-bottom:8px; line-height:1.3;">
                <%= uName %>
              </h3>

              <div style="display:flex; align-items:center; gap:6px; font-size:13px; color:var(--text-secondary); margin-bottom:18px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= u.city %>
              </div>

              <div style="margin-bottom:18px;">
                <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:8px;">Key Faculties:</div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;">
                  <% (u.faculties || []).slice(0, 5).forEach(function(fac) { %>
                    <span style="background:var(--bg-card-subtle); color:var(--text-secondary); border:1px solid var(--border-subtle); padding:4px 10px; border-radius:980px; font-size:11.5px; font-weight:600;">
                      <%= fac %>
                    </span>
                  <% }); %>
                  <% if (u.faculties && u.faculties.length > 5) { %>
                    <span style="background:var(--bg-card-subtle); color:var(--text-secondary); border:1px solid var(--border-subtle); padding:4px 10px; border-radius:980px; font-size:11px; font-weight:700;">
                      +<%= u.faculties.length - 5 %> more
                    </span>
                  <% } %>
                </div>
              </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding-top:16px; border-top:1px solid var(--border-subtle); margin-top:14px; flex-wrap:wrap; gap:8px;">
              <a href="/degrees/all/?q=<%= encodeURIComponent(uName) %>" style="color:var(--apple-blue); font-weight:600; font-size:13.5px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
                Browse Degrees →
              </a>
              <div style="display:flex; gap:12px; align-items:center;">
                <a href="/student-tools/cost-planner/" style="color:var(--text-secondary); font-size:12px; text-decoration:none;" title="Calculate estimated student living cost in <%= u.city %>">
                  Living Cost ↗
                </a>
                <% if (u.site) { %>
                  <a href="<%= u.site %>" target="_blank" rel="noopener" style="color:var(--text-secondary); font-size:12px; text-decoration:none;">
                    Official Portal ↗
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
