<%- include('partials/head', { title: "University Z-Score Explorer - UniScope LK" }) %>
<%- include('partials/navbar') %>

<div style="background:var(--bg-page); min-height: 100vh; padding: 100px 20px 80px; color:var(--text-main);">
  <div class="container" style="max-width: 1200px;">
    
    <!-- Hero / Title -->
    <div style="text-align:center; margin-bottom: 32px;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:var(--apple-blue-subtle); color:var(--apple-blue); padding:5px 16px; border-radius:980px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:14px; border:1px solid rgba(0,113,227,0.2);">
        <span style="width:7px; height:7px; border-radius:50%; background:var(--apple-blue); display:inline-block;"></span>
        Official UGC Admissions Data · Academic Year <%= latestYear %>
      </div>
      <h1 style="font-family:-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif; font-size: clamp(28px, 4vw, 40px); font-weight: 700; letter-spacing: -0.03em; color:var(--text-main); margin-bottom: 10px;">
        University Z-Score Explorer
      </h1>
      <p style="color:var(--text-secondary); font-size: 16px; max-width: 700px; margin: 0 auto; line-height: 1.55;">
        Official Sri Lankan University Grants Commission (UGC) minimum selection Z-Scores across all 25 administrative districts with 4-year historical comparative trend analysis.
      </p>
    </div>

    <!-- Filter Card -->
    <div class="uniscope-card" style="padding:28px; margin-bottom:30px; border-radius:var(--radius-xl);">
      <form method="GET" action="/degrees/cutoff-tool/" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; align-items:flex-end;">
        
        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">A/L Stream</label>
          <select name="stream" class="uniscope-select">
            <option value="">All Streams</option>
            <option value="Physical Science" <%= selectedStream === 'Physical Science' ? 'selected' : '' %>>Physical Science</option>
            <option value="Bio Science" <%= selectedStream === 'Bio Science' ? 'selected' : '' %>>Biological Science</option>
            <option value="Commerce" <%= selectedStream === 'Commerce' ? 'selected' : '' %>>Commerce</option>
            <option value="Technology" <%= selectedStream === 'Technology' ? 'selected' : '' %>>Technology</option>
            <option value="Arts" <%= selectedStream === 'Arts' ? 'selected' : '' %>>Arts</option>
            <option value="Common" <%= selectedStream === 'Common' ? 'selected' : '' %>>Common</option>
          </select>
        </div>

        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">District (All 25)</label>
          <select name="district" class="uniscope-select">
            <option value="">All Districts</option>
            <% districts.forEach(function(dist) { %>
              <option value="<%= dist %>" <%= selectedDistrict === dist ? 'selected' : '' %>><%= dist %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">Academic Year</label>
          <select name="year" class="uniscope-select">
            <option value="2025/2026" <%= selectedYear === '2025/2026' ? 'selected' : '' %>>2025/2026 (Latest Official UGC)</option>
            <option value="2024/2025" <%= selectedYear === '2024/2025' ? 'selected' : '' %>>2024/2025 (Historical Reference)</option>
            <option value="2023/2024" <%= selectedYear === '2023/2024' ? 'selected' : '' %>>2023/2024 (Historical Reference)</option>
            <option value="2022/2023" <%= selectedYear === '2022/2023' ? 'selected' : '' %>>2022/2023 (Historical Reference)</option>
          </select>
        </div>

        <div>
          <label style="display:block; font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">Your Z-Score (Optional)</label>
          <input type="number" step="0.0001" name="myZ" value="<%= myZ || '' %>" placeholder="e.g. 1.8420" class="uniscope-input">
        </div>

        <div>
          <button type="submit" class="btn-primary" style="width:100%; height:44px; display:inline-flex; align-items:center; justify-content:center; font-weight:600; border-radius:12px; cursor:pointer;">
            Filter Cut-Offs
          </button>
        </div>
      </form>
    </div>

    <!-- Active Academic Year Cutoff Table -->
    <div class="uniscope-card" style="overflow:hidden; border-radius:var(--radius-xl); margin-bottom:36px;">
      <div style="padding:18px 24px; background:var(--bg-card-subtle); border-bottom:1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:15px; font-weight:700; color:var(--text-main);">
            Showing <%= cutoffs.length %> Cut-Off Records for <%= selectedYear %>
          </span>
          <% if (selectedYear === latestYear) { %>
            <span style="background:var(--status-success-bg, rgba(16,185,129,0.12)); color:#10b981; border:1px solid rgba(16,185,129,0.3); padding:3px 10px; border-radius:980px; font-size:11px; font-weight:700; text-transform:uppercase;">
              Latest Official UGC
            </span>
          <% } else { %>
            <span style="background:var(--bg-card); color:var(--text-secondary); border:1px solid var(--border-subtle); padding:3px 10px; border-radius:980px; font-size:11px; font-weight:600;">
              Historical Archive
            </span>
          <% } %>
        </div>

        <% if (myZ) { %>
          <span style="background:var(--apple-blue-subtle); color:var(--apple-blue); border:1px solid rgba(0,113,227,0.25); padding:4px 14px; border-radius:980px; font-size:13px; font-weight:600;">
            Comparing against your Z-Score: <strong><%= myZ %></strong>
          </span>
        <% } %>
      </div>

      <div style="overflow-x:auto;">
        <table class="uniscope-table" style="min-width:760px;">
          <thead>
            <tr>
              <th style="width:90px;">Code</th>
              <th>Degree Course Name</th>
              <th>Stream</th>
              <th>District</th>
              <th>Min Z-Score</th>
              <% if (myZ) { %>
                <th>Eligibility Status</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% if (cutoffs && cutoffs.length > 0) { %>
              <% cutoffs.forEach(function(row) { %>
                <tr>
                  <td>
                    <span style="background:var(--apple-blue-subtle); color:var(--apple-blue); border:1px solid rgba(0,113,227,0.2); padding:3px 8px; border-radius:6px; font-weight:700; font-size:12px; font-variant-numeric:tabular-nums;"><%= row.course_code %></span>
                  </td>
                  <td style="font-weight:600; color:var(--text-main);">
                    <%= row.course_name %>
                  </td>
                  <td style="color:var(--text-secondary); font-size:13.5px;"><%= row.stream %></td>
                  <td style="font-weight:600; font-size:13.5px;"><%= row.district %></td>
                  <td>
                    <% if (typeof row.min_zscore === 'number') { %>
                      <span style="font-weight:700; color:var(--apple-blue); font-size:15px; font-variant-numeric:tabular-nums;">
                        <%= row.min_zscore.toFixed(4) %>
                      </span>
                    <% } else { %>
                      <span style="background:var(--bg-card-subtle); color:var(--text-muted); border:1px solid var(--border-subtle); padding:3px 8px; border-radius:6px; font-weight:700; font-size:12px;" title="No Qualified Candidates">
                        <%= row.min_zscore %>
                      </span>
                    <% } %>
                  </td>
                  <% if (myZ) { %>
                    <td>
                      <% if (typeof row.min_zscore === 'number') { %>
                        <% var diff = (parseFloat(myZ) - row.min_zscore).toFixed(4); %>
                        <% if (parseFloat(myZ) >= row.min_zscore) { %>
                          <span style="color:#10b981; font-weight:600; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); padding:4px 10px; border-radius:6px; font-size:12px; display:inline-flex; align-items:center; gap:4px;">
                            ✓ Qualified (+<%= diff %>)
                          </span>
                        <% } else { %>
                          <span style="color:#ef4444; font-weight:600; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); padding:4px 10px; border-radius:6px; font-size:12px; display:inline-flex; align-items:center; gap:4px;">
                            ✕ Shortfall (<%= diff %>)
                          </span>
                        <% } %>
                      <% } else { %>
                        <span style="color:var(--text-muted); font-size:12px;">N/A (<%= row.min_zscore %>)</span>
                      <% } %>
                    </td>
                  <% } %>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="<%= myZ ? 6 : 5 %>" style="text-align:center; padding:48px 20px; color:var(--text-muted);">
                  No cut-off records matched the selected stream or district filter.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Collapsible Historical Z-Score Comparison Section -->
    <details class="uniscope-card" style="padding:0; overflow:hidden; border-radius:var(--radius-xl); margin-bottom:30px;" <%= (selectedStream || selectedDistrict) ? 'open' : '' %>>
      <summary style="padding:20px 26px; cursor:pointer; font-weight:700; font-size:16px; color:var(--text-main); display:flex; justify-content:space-between; align-items:center; background:var(--bg-card); user-select:none; border-bottom:1px solid var(--border-subtle);">
        <div style="display:flex; align-items:center; gap:10px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" style="color:var(--apple-blue);">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <span>Historical Z-Score Trends (2022/2023 – 2025/2026) for <%= trendDistrict %> District</span>
        </div>
        <span style="font-size:13px; font-weight:600; color:var(--apple-blue);">Toggle Analysis ▾</span>
      </summary>

      <div style="padding:24px 26px;">
        <p style="font-size:14px; color:var(--text-secondary); line-height:1.6; margin-bottom:20px;">
          Below is a 4-year comparative breakdown of minimum selection scores published by the UGC for Sri Lankan state universities across recent admissions cycles.
        </p>

        <!-- Tabular Comparison -->
        <div style="overflow-x:auto;">
          <table class="uniscope-table" style="min-width:800px;">
            <thead>
              <tr>
                <th style="width:80px;">Code</th>
                <th>Degree Course</th>
                <th>Stream</th>
                <th>2022/2023</th>
                <th>2023/2024</th>
                <th>2024/2025</th>
                <th>2025/2026 (Latest)</th>
                <th>4-Year Direction</th>
              </tr>
            </thead>
            <tbody>
              <% if (historicalTrends && historicalTrends.length > 0) { %>
                <% historicalTrends.forEach(function(item) { %>
                  <tr>
                    <td><span style="font-weight:700; color:var(--apple-blue); font-size:12px;"><%= item.course_code %></span></td>
                    <td style="font-weight:600; color:var(--text-main);"><%= item.course_name %></td>
                    <td style="color:var(--text-secondary); font-size:13px;"><%= item.stream %></td>
                    <td style="font-variant-numeric:tabular-nums; font-size:13.5px;"><%= typeof item.records['2022/2023'] === 'number' ? item.records['2022/2023'].toFixed(4) : item.records['2022/2023'] %></td>
                    <td style="font-variant-numeric:tabular-nums; font-size:13.5px;"><%= typeof item.records['2023/2024'] === 'number' ? item.records['2023/2024'].toFixed(4) : item.records['2023/2024'] %></td>
                    <td style="font-variant-numeric:tabular-nums; font-size:13.5px;"><%= typeof item.records['2024/2025'] === 'number' ? item.records['2024/2025'].toFixed(4) : item.records['2024/2025'] %></td>
                    <td style="font-variant-numeric:tabular-nums; font-weight:700; color:var(--apple-blue); font-size:14px;"><%= typeof item.records['2025/2026'] === 'number' ? item.records['2025/2026'].toFixed(4) : item.records['2025/2026'] %></td>
                    <td>
                      <span style="font-size:12px; font-weight:700; color:<%= item.trend.includes('↑') ? '#ef4444' : (item.trend.includes('↓') ? '#10b981' : 'var(--text-muted)') %>;">
                        <%= item.trend %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" style="text-align:center; padding:30px; color:var(--text-muted);">
                    Select a stream or district to inspect multi-year historical trends.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Official Disclaimer -->
        <div style="margin-top:20px; padding:14px 18px; border-radius:12px; background:var(--bg-card-subtle); border:1px solid var(--border-subtle); display:flex; align-items:flex-start; gap:12px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" style="color:var(--text-muted); flex-shrink:0; margin-top:2px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <div style="font-size:13px; color:var(--text-secondary); line-height:1.55;">
            <strong>Important Admissions Advisory:</strong> Historical cut-offs show how minimum selection scores changed in previous academic years. They do not predict or guarantee admission. UGC selection criteria depend upon candidate performance distributions, faculty intake quotas, and district demographic allocations for each specific examination cohort.
          </div>
        </div>
      </div>
    </details>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>