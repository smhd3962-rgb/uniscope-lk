<%- include('partials/head', { title: "Student Services & Official Resources - UniScope LK" }) %>
<%- include('partials/navbar') %>

<style>
.services-page {
  background: var(--bg-page);
  min-height: 100vh;
  padding: 100px 20px 80px;
  color: var(--text-main);
}

.services-container {
  max-width: 1200px;
  margin: 0 auto;
}

/* Hero Section */
.services-hero {
  text-align: center;
  max-width: 860px;
  margin: 0 auto 36px;
}

.services-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--apple-blue-subtle);
  color: var(--apple-blue);
  padding: 6px 18px;
  border-radius: 980px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 14px;
  border: 1px solid rgba(0, 113, 227, 0.2);
}

.services-title {
  font-size: clamp(30px, 4.5vw, 44px);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--text-main);
  line-height: 1.15;
  margin: 0 0 14px;
}

.services-subtitle {
  font-size: 19px;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8px;
  letter-spacing: -0.015em;
}

.services-desc {
  font-size: 15.5px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin: 0 auto 24px;
  max-width: 760px;
}

.services-notice-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(16, 185, 129, 0.08);
  border: 1px solid rgba(16, 185, 129, 0.25);
  color: #059669;
  padding: 6px 16px;
  border-radius: 980px;
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.4;
}

/* Search Bar */
.services-search-wrap {
  max-width: 720px;
  margin: 0 auto 32px;
  position: relative;
}

.services-search-input {
  width: 100%;
  padding: 16px 50px 16px 52px;
  border-radius: 980px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  font-size: 15.5px;
  color: var(--text-main);
  outline: none;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  font-family: inherit;
}

.services-search-input:focus {
  border-color: var(--apple-blue);
  box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.15), var(--shadow-md);
}

.services-search-icon {
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
}

.services-clear-btn {
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  border-radius: 50%;
  display: none;
  align-items: center;
  justify-content: center;
}

.services-clear-btn:hover {
  color: var(--text-main);
  background: var(--bg-card-subtle);
}

/* Category Filter Tabs */
.services-tabs {
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

.services-tab-btn {
  padding: 8px 18px;
  border-radius: 980px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.15s ease;
  font-family: inherit;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.services-tab-btn:hover {
  color: var(--apple-blue);
  border-color: rgba(0, 113, 227, 0.4);
  transform: translateY(-1px);
}

.services-tab-btn.active {
  background: var(--apple-blue);
  color: #ffffff;
  border-color: var(--apple-blue);
  box-shadow: 0 2px 8px rgba(0, 113, 227, 0.25);
}

.services-tab-count {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 980px;
  background: rgba(0, 0, 0, 0.08);
}

.services-tab-btn.active .services-tab-count {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* Filter Summary Bar */
.services-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
  font-size: 13.5px;
  color: var(--text-secondary);
  flex-wrap: wrap;
  gap: 10px;
  padding: 0 4px;
}

/* Featured Quick Access Strip */
.featured-section {
  margin-bottom: 40px;
}

.featured-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.featured-header h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.015em;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.featured-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 18px;
}

.featured-card {
  background: var(--bg-card);
  border: 1px solid rgba(0, 113, 227, 0.22);
  border-radius: var(--radius-xl, 18px);
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  box-shadow: 0 4px 18px rgba(0, 113, 227, 0.06);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
}

.featured-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 28px rgba(0, 113, 227, 0.14);
  border-color: var(--apple-blue);
}

.featured-badge {
  position: absolute;
  top: 14px;
  right: 16px;
  background: var(--apple-blue);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 980px;
}

/* Complete Directory Grid */
.directory-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 22px;
  margin-bottom: 48px;
}

.service-card {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-xl, 18px);
  padding: 26px 24px 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  box-shadow: var(--shadow-sm);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
}

.service-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
  border-color: rgba(0, 113, 227, 0.35);
}

.service-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14px;
}

.service-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--apple-blue-subtle);
  color: var(--apple-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.service-cat-pill {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-secondary);
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-subtle);
  padding: 3px 10px;
  border-radius: 980px;
}

.service-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.015em;
  line-height: 1.3;
  margin: 0 0 6px;
}

.service-provider {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--apple-blue);
  display: flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 12px;
}

.service-desc {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin: 0 0 16px;
  flex: 1;
}

.service-meta-strip {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 16px;
  padding-top: 10px;
  border-top: 1px solid var(--border-subtle);
}

.service-pill-tag {
  font-size: 11.5px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--bg-card-subtle);
  padding: 3px 8px;
  border-radius: 6px;
}

.service-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid var(--border-subtle);
}

.service-verified-badge {
  font-size: 11.5px;
  color: #059669;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.service-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 18px;
  border-radius: 980px;
  background: var(--apple-blue);
  color: #ffffff !important;
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s ease;
}

.service-action-btn:hover {
  background: #0077ed;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(0, 113, 227, 0.3);
}

.service-action-btn:active {
  transform: scale(0.97);
}

/* Empty State */
.services-empty-state {
  display: none;
  text-align: center;
  padding: 60px 20px;
  background: var(--bg-card);
  border-radius: 20px;
  border: 1px solid var(--border-card);
  margin: 20px 0;
}

/* Favorite Star Button */
.fav-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: color 0.15s ease, transform 0.15s ease;
}

.fav-btn:hover {
  color: #f59e0b;
  transform: scale(1.15);
}

.fav-btn.active {
  color: #f59e0b;
}

.fav-btn.active svg {
  fill: #f59e0b;
}
</style>

<div class="services-page">
  <div class="services-container">
    
    <!-- Section 1: Introduction -->
    <div class="services-hero">
      <div class="services-eyebrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Verified Official Government &amp; Education Directory
      </div>
      <h1 class="services-title">
        Student Services &amp; Official Resources
      </h1>
      <div class="services-subtitle">
        Everything Students Need, in One Place
      </div>
      <p class="services-desc">
        Quick access to trusted education and government services across Sri Lanka. Find examination results, university admission services, scholarships, government documents, learning resources, and other essential links for students across Sri Lanka.
      </p>
      <div class="services-notice-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>100% Direct Official Links (.gov.lk / .ac.lk / Statutory Trusts) · No Personal Information Collected</span>
      </div>
    </div>

    <!-- Interactive Student Tools Banner -->
    <div style="background:var(--card-bg, #ffffff); border:1px solid var(--border-color, #e2e8f0); border-radius:18px; padding:18px 24px; margin: 0 auto 30px; max-width:860px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; box-shadow:0 4px 16px rgba(0,0,0,0.03);">
      <div>
        <div style="font-size:11.5px; font-weight:700; text-transform:uppercase; color:var(--apple-blue); letter-spacing:0.04em; margin-bottom:2px;">Interactive Planning Tools</div>
        <div style="font-size:14.5px; font-weight:700; color:var(--text-main);">Try UniScope Interactive Student Tools</div>
      </div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/student-tools/application-checklist/" style="padding:7px 14px; border-radius:980px; font-size:12.5px; font-weight:600; text-decoration:none; background:rgba(0,113,227,0.08); color:var(--apple-blue); border:1px solid rgba(0,113,227,0.2);">
          ✓ Application Checklist
        </a>
        <a href="/student-tools/cost-planner/" style="padding:7px 14px; border-radius:980px; font-size:12.5px; font-weight:600; text-decoration:none; background:rgba(16,185,129,0.08); color:#10b981; border:1px solid rgba(16,185,129,0.2);">
          Rs. Cost-of-Living Planner
        </a>
        <a href="/student-tools/degree-recognition/" style="padding:7px 14px; border-radius:980px; font-size:12.5px; font-weight:600; text-decoration:none; background:rgba(99,102,241,0.08); color:#6366f1; border:1px solid rgba(99,102,241,0.2);">
          ★ Degree Recognition Guide
        </a>
      </div>
    </div>

    <!-- Section 2: Prominent Search Input -->
    <div class="services-search-wrap">
      <svg class="services-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text"
             id="servicesSearchInput"
             class="services-search-input"
             placeholder="Search results, university admission, certificates, scholarships, HND..."
             aria-label="Search student services and official resources"
             oninput="handleServiceSearch()">
      <button id="servicesClearBtn" class="services-clear-btn" onclick="clearServiceSearch()" aria-label="Clear search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Section 3: Categories Filter -->
    <div class="services-tabs" role="tablist">
      <button class="services-tab-btn active" onclick="filterCategory('all', this)">
        <span>All Services</span>
        <span class="services-tab-count"><%= services.length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('exams', this)">
        <span>Exams &amp; Results</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'exams').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('admissions', this)">
        <span>University Admissions</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'admissions').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('scholarships', this)">
        <span>Scholarships</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'scholarships').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('documents', this)">
        <span>Documents</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'documents').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('learning', this)">
        <span>Learning Resources</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'learning').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('technical', this)">
        <span>Technical Education</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'technical').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('careers', this)">
        <span>Careers</span>
        <span class="services-tab-count"><%= services.filter(s => s.category === 'careers').length %></span>
      </button>
      <button class="services-tab-btn" onclick="filterCategory('saved', this)">
        <span>★ Saved Services</span>
        <span class="services-tab-count" id="savedCountBadge">0</span>
      </button>
    </div>

    <!-- Active Status Bar -->
    <div class="services-status-bar">
      <div id="servicesCountDisplay">
        Showing <strong><span id="visibleCount"><%= services.length %></span></strong> of <%= services.length %> verified official services
      </div>
      <div style="display:flex; align-items:center; gap:16px;">
        <span style="font-size:12.5px; color:var(--text-muted);">Last comprehensive audit: November 2026</span>
      </div>
    </div>

    <!-- Section 4: Frequently Used / Featured Services (6 Top Destinations) -->
    <div class="featured-section" id="featuredSection">
      <div class="featured-header">
        <h3>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" style="color:var(--apple-blue);">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          Frequently Used Official Destinations
        </h3>
        <span style="font-size:13px; color:var(--text-muted);">Quick-launch official government portals</span>
      </div>

      <div class="featured-grid">
        <!-- 1. Check Examination Results -->
        <div class="featured-card">
          <span class="featured-badge">Featured</span>
          <div>
            <div style="font-size:11.5px; font-weight:700; color:var(--apple-blue); text-transform:uppercase; margin-bottom:4px;">1. Exams &amp; Results</div>
            <h4 style="font-size:17px; font-weight:700; margin:0 0 6px; color:var(--text-main);">Check Examination Results</h4>
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">Department of Examinations, Sri Lanka</div>
            <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
              Access official G.C.E. A/L, O/L, and Grade 5 Scholarship examination results by entering your exam index number.
            </p>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11.5px; color:#059669; font-weight:600;">✓ Verified results.exams.gov.lk</span>
            <a href="https://www.results.exams.gov.lk/home.htm" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>
        </div>

        <!-- 2. Check University Selection -->
        <div class="featured-card">
          <span class="featured-badge">Featured</span>
          <div>
            <div style="font-size:11.5px; font-weight:700; color:var(--apple-blue); text-transform:uppercase; margin-bottom:4px;">2. University Admissions</div>
            <h4 style="font-size:17px; font-weight:700; margin:0 0 6px; color:var(--text-main);">Check University Selection (2025/2026)</h4>
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">University Grants Commission (UGC)</div>
            <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
              Verify official course allocations, state university placements, and faculty registration schedules published by the UGC.
            </p>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11.5px; color:#059669; font-weight:600;">✓ Verified ugc.ac.lk</span>
            <a href="https://www.ugc.ac.lk/selection_26/" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>
        </div>

        <!-- 3. University Admission Handbook -->
        <div class="featured-card">
          <span class="featured-badge">Featured</span>
          <div>
            <div style="font-size:11.5px; font-weight:700; color:var(--apple-blue); text-transform:uppercase; margin-bottom:4px;">3. Admissions Guide</div>
            <h4 style="font-size:17px; font-weight:700; margin:0 0 6px; color:var(--text-main);">Official UGC Admission Handbook</h4>
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">University Grants Commission (eUGC)</div>
            <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
              Read the complete digital guide to minimum qualification criteria, subject combinations, district quotas, and degree choices.
            </p>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11.5px; color:#059669; font-weight:600;">✓ Verified eugc.ugc.ac.lk</span>
            <a href="https://eugc.ugc.ac.lk/ugc_handbook/" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>
        </div>

        <!-- 4. Request Exam Certificates -->
        <div class="featured-card">
          <span class="featured-badge">Featured</span>
          <div>
            <div style="font-size:11.5px; font-weight:700; color:var(--apple-blue); text-transform:uppercase; margin-bottom:4px;">4. Certificates</div>
            <h4 style="font-size:17px; font-weight:700; margin:0 0 6px; color:var(--text-main);">Request Exam Certificates Online</h4>
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">Department of Examinations, Sri Lanka</div>
            <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
              Apply for authenticated G.C.E. O/L and A/L result certificates with optional Foreign Ministry verification and doorstep delivery.
            </p>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11.5px; color:#059669; font-weight:600;">✓ Verified certificate.doenets.lk</span>
            <a href="https://certificate.doenets.lk/" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>
        </div>

        <!-- 5. View Scholarship Opportunities -->
        <div class="featured-card">
          <span class="featured-badge">Featured</span>
          <div>
            <div style="font-size:11.5px; font-weight:700; color:var(--apple-blue); text-transform:uppercase; margin-bottom:4px;">5. Student Finance</div>
            <h4 style="font-size:17px; font-weight:700; margin:0 0 6px; color:var(--text-main);">Mahapola &amp; Student Loan Schemes</h4>
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">Mahapola Trust &amp; Ministry of Higher Education</div>
            <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
              Access official scholarship grants and government interest-free loan schemes for state and non-state undergraduate programmes.
            </p>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11.5px; color:#059669; font-weight:600;">✓ Verified mahapola.lk</span>
            <a href="https://www.mahapola.lk/" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>
        </div>

        <!-- 6. Apply for HND Programmes -->
        <div class="featured-card">
          <span class="featured-badge">Featured</span>
          <div>
            <div style="font-size:11.5px; font-weight:700; color:var(--apple-blue); text-transform:uppercase; margin-bottom:4px;">6. Technical Education</div>
            <h4 style="font-size:17px; font-weight:700; margin:0 0 6px; color:var(--text-main);">Apply for SLIATE HND Programmes</h4>
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">SLIATE (Ministry of Education)</div>
            <p style="font-size:13.5px; color:var(--text-secondary); line-height:1.55; margin:0 0 16px;">
              Apply online for Higher National Diplomas across 18 Advanced Technological Institutes (Engineering, IT, Business, Accountancy).
            </p>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:11.5px; color:#059669; font-weight:600;">✓ Verified apply.sliate.ac.lk</span>
            <a href="https://apply.sliate.ac.lk/" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 5: Complete Directory Grid -->
    <div style="margin-bottom: 24px;">
      <h3 style="font-size: 20px; font-weight: 700; color: var(--text-main); margin: 0 0 6px; letter-spacing: -0.02em;">
        Complete Verified Service Directory
      </h3>
      <p style="font-size: 14px; color: var(--text-secondary); margin: 0;">
        Showing all verified government portals, educational boards, and student support services.
      </p>
    </div>

    <div class="directory-grid" id="servicesDirectoryGrid">
      <% services.forEach(function(s) { %>
        <div class="service-card"
             data-id="<%= s.id %>"
             data-category="<%= s.category %>"
             data-keywords="<%= (s.keywords || []).join(' ') %>"
             data-title="<%= s.title.toLowerCase() %>"
             data-provider="<%= s.provider.toLowerCase() %>"
             data-description="<%= s.description.toLowerCase() %>"
             data-audience="<%= (s.targetAudience || '').toLowerCase() %>">
          
          <div>
            <div class="service-card-top">
              <div class="service-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                  <% if (s.category === 'exams') { %>
                    <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                  <% } else if (s.category === 'admissions') { %>
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  <% } else if (s.category === 'scholarships') { %>
                    <rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>
                  <% } else if (s.category === 'documents') { %>
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                  <% } else if (s.category === 'learning') { %>
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                  <% } else if (s.category === 'technical') { %>
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                  <% } else { %>
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
                  <% } %>
                </svg>
              </div>

              <div style="display:flex; align-items:center; gap:8px;">
                <span class="service-cat-pill"><%= s.categoryName %></span>
                <button class="fav-btn" onclick="toggleFavorite('<%= s.id %>', this)" title="Bookmark this service" aria-label="Bookmark service">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                </button>
              </div>
            </div>

            <h4 class="service-title"><%= s.title %></h4>
            <div class="service-provider">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4"/>
              </svg>
              <span><%= s.provider %></span>
            </div>

            <p class="service-desc"><%= s.description %></p>

            <div class="service-meta-strip">
              <% if (s.academicYear) { %>
                <span class="service-pill-tag">Cycle: <%= s.academicYear %></span>
              <% } %>
              <% if (s.targetAudience) { %>
                <span class="service-pill-tag">For: <%= s.targetAudience %></span>
              <% } %>
            </div>
          </div>

          <div class="service-card-bottom">
            <span class="service-verified-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              Verified Nov 2026
            </span>
            <a href="<%= s.officialUrl %>" target="_blank" rel="noopener noreferrer" class="service-action-btn">
              Visit Official Website ↗
            </a>
          </div>

        </div>
      <% }); %>
    </div>

    <!-- Empty State -->
    <div id="servicesEmptyState" class="services-empty-state">
      <div style="width:64px; height:64px; border-radius:50%; background:var(--apple-blue-subtle); color:var(--apple-blue); margin:0 auto 16px; display:flex; align-items:center; justify-content:center;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="30" height="30">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <h3 style="font-size:20px; font-weight:700; color:var(--text-main); margin:0 0 8px;">No matching services found</h3>
      <p style="font-size:14.5px; color:var(--text-secondary); max-width:480px; margin:0 auto 20px;">
        We couldn't find any verified government service matching your search. Try checking your spelling, using broader keywords, or clearing your category filters.
      </p>
      <button onclick="resetAllFilters()" class="btn-primary" style="padding:10px 22px; font-size:14px;">
        Reset Search &amp; Filters
      </button>
    </div>

    <!-- Section 6: Contextual Integration & Security Disclaimer -->
    <div class="uniscope-card" style="padding:32px; border-radius:20px; margin-top:20px; background:var(--bg-card-subtle);">
      <div style="display:flex; align-items:flex-start; gap:16px;">
        <div style="width:40px; height:40px; border-radius:10px; background:rgba(0,113,227,0.1); color:var(--apple-blue); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
        </div>
        <div style="font-size:13.5px; color:var(--text-secondary); line-height:1.65;">
          <h4 style="font-size:16px; font-weight:700; color:var(--text-main); margin:0 0 6px;">
            Security, Privacy &amp; Official Attribution Guidelines
          </h4>
          <p style="margin:0 0 8px;">
            UniScope LK operates this public student directory as an educational public service. All destination websites are owned and managed by their respective ministries, statutory boards, and government departments under the Democratic Socialist Republic of Sri Lanka.
          </p>
          <p style="margin:0;">
            <strong>Protection Notice:</strong> UniScope LK will never ask students to enter examination index numbers, NIC numbers, passport numbers, or private credentials to view this directory. Always confirm that your browser address bar reflects the official <code>.gov.lk</code> or <code>.ac.lk</code> domain when submitting official forms. To suggest an additional verified link or report a domain change, contact <a href="mailto:contact@uniscope.lk" style="color:var(--apple-blue); font-weight:600;">contact@uniscope.lk</a>.
          </p>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>

<script>
let currentCategory = 'all';

function getFavorites() {
  try {
    return JSON.parse(localStorage.getItem('uniscope_fav_services') || '[]');
  } catch (e) {
    return [];
  }
}

function updateFavBadges() {
  const favs = getFavorites();
  const countBadge = document.getElementById('savedCountBadge');
  if (countBadge) countBadge.textContent = favs.length;

  document.querySelectorAll('.service-card').forEach(card => {
    const id = card.getAttribute('data-id');
    const btn = card.querySelector('.fav-btn');
    if (btn) {
      if (favs.includes(id)) {
        btn.classList.add('active');
        btn.title = 'Saved to Bookmarks';
      } else {
        btn.classList.remove('active');
        btn.title = 'Bookmark this service';
      }
    }
  });
}

function toggleFavorite(id, btn) {
  let favs = getFavorites();
  if (favs.includes(id)) {
    favs = favs.filter(item => item !== id);
  } else {
    favs.push(id);
  }
  localStorage.setItem('uniscope_fav_services', JSON.stringify(favs));
  updateFavBadges();
  if (currentCategory === 'saved') {
    applyFilters();
  }
}

function filterCategory(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll('.services-tab-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  // Hide or show featured section based on category
  const featured = document.getElementById('featuredSection');
  if (featured) {
    featured.style.display = (cat === 'all') ? 'block' : 'none';
  }

  applyFilters();
}

function handleServiceSearch() {
  const query = document.getElementById('servicesSearchInput').value.trim();
  const clearBtn = document.getElementById('servicesClearBtn');
  if (clearBtn) {
    clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
  }
  applyFilters();
}

function clearServiceSearch() {
  const input = document.getElementById('servicesSearchInput');
  input.value = '';
  document.getElementById('servicesClearBtn').style.display = 'none';
  input.focus();
  applyFilters();
}

function resetAllFilters() {
  const input = document.getElementById('servicesSearchInput');
  input.value = '';
  document.getElementById('servicesClearBtn').style.display = 'none';
  const firstTab = document.querySelector('.services-tab-btn');
  filterCategory('all', firstTab);
}

function applyFilters() {
  const q = document.getElementById('servicesSearchInput').value.toLowerCase().trim();
  const cards = document.querySelectorAll('.service-card');
  const favs = getFavorites();
  let visible = 0;

  cards.forEach(card => {
    const id = card.getAttribute('data-id');
    const cat = card.getAttribute('data-category');
    const title = card.getAttribute('data-title') || '';
    const desc = card.getAttribute('data-description') || '';
    const prov = card.getAttribute('data-provider') || '';
    const kw = card.getAttribute('data-keywords') || '';
    const aud = card.getAttribute('data-audience') || '';

    // Category match
    let matchesCategory = false;
    if (currentCategory === 'all') {
      matchesCategory = true;
    } else if (currentCategory === 'saved') {
      matchesCategory = favs.includes(id);
    } else {
      matchesCategory = (cat === currentCategory);
    }

    // Text search match
    let matchesQuery = true;
    if (q) {
      matchesQuery = title.includes(q) || desc.includes(q) || prov.includes(q) || kw.includes(q) || aud.includes(q);
    }

    if (matchesCategory && matchesQuery) {
      card.style.display = 'flex';
      visible++;
    } else {
      card.style.display = 'none';
    }
  });

  const visibleCountEl = document.getElementById('visibleCount');
  if (visibleCountEl) visibleCountEl.textContent = visible;

  const emptyState = document.getElementById('servicesEmptyState');
  const grid = document.getElementById('servicesDirectoryGrid');
  if (visible === 0) {
    if (emptyState) emptyState.style.display = 'block';
    if (grid) grid.style.display = 'none';
  } else {
    if (emptyState) emptyState.style.display = 'none';
    if (grid) grid.style.display = 'grid';
  }
}

document.addEventListener('DOMContentLoaded', () => {
  updateFavBadges();
});
</script>
